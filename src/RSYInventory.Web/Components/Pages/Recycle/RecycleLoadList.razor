    private DateTime? _filterTo;
    private RecycleLoad? _detail;
    private ImageViewer? _viewer;

    private bool _showCreate;
    private string _createLoadId = "";
    private string _createDriverId = "0";
    private string _createBillToId = "0";
    private string _createNotes = "";
    private decimal _createRate = 575m;
    private string _createTruck = "";
    private DateTime? _createLoadDate = DateTime.Today;
    private readonly List<DocSlot> _docSlots =
    [
        new(RecycleDocumentType.Bol, "BOL"),
        new(RecycleDocumentType.Nucor, "NUCOR"),
        new(RecycleDocumentType.Scale, "SCALE")
    ];

    private string _editLoadId = "";
    private string _editDriverId = "0";
    private string _editBillToId = "0";
    private string _editNotes = "";
    private decimal _editRate = 575m;
    private string _editTruck = "";
    private DateTime? _editLoadDate;

    private bool _showBillTo;
    private int? _billToEditId;
    private string _billToAlias = "";
    private string _billToName = "";
    private string _billToAddress = "";
    private string _billToContact = "";
    private bool _billToActive = true;

    private string _invoiceBillToId = "0";
    private DateTime? _invoicePickDate;
    private DateOnly? _invoiceMonday;
    private DateOnly? _invoiceFriday;
    private bool _needReplacePassword;
    private string _replacePassword = "";
    private RecycleWeeklyInvoice? _deleteInvoiceTarget;

    private RecycleWeeklyInvoice? _paymentInvoice;
    private DateTime? _paymentCheckDate = DateTime.Today;
    private decimal? _paymentAmount;
    private string? _paymentNotes;
    private string? _paymentImagePath;
    private IBrowserFile? _paymentPendingFile;
    private string? _paymentError;

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (!CurrentUser.CanManageScrapLogistics) return;

        SelectLastWeek();

        try
        {
            await Busy.RunAsync(async () =>
            {
                _drivers = await Loads.GetRecycleDriversAsync();
                await LoadItemsAsync();
                await LoadInvoicePanelsAsync();
            }, "Cargando agenda de reciclaje…");
        }
        catch (Exception ex)
        {
            _error = ex.Message + " — ¿Ejecutaste 018 / 019 / 020_RecycleLoadBillTo.sql?";
        }
    }

    private async Task LoadInvoicePanelsAsync()
    {
        _billToCompanies = await Invoices.GetBillToCompaniesAsync(activeOnly: false);
        _invoices = await Invoices.ListInvoicesAsync();
    }

    private async Task ReloadAsync()
    {
        _error = null;
        try
        {
            await Busy.RunAsync(LoadItemsAsync, "Filtrando…");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toasts.Error(ex.Message);
        }
    }

    private async Task LoadItemsAsync()
    {
        int? driverId = int.TryParse(_filterDriverId, out var id) && id > 0 ? id : null;
        DateOnly? from = _filterFrom is null ? null : DateOnly.FromDateTime(_filterFrom.Value);
        DateOnly? to = _filterTo is null ? null : DateOnly.FromDateTime(_filterTo.Value);
        bool? verified = _filterVerified switch
        {
            "pending" => false,
            "ok" => true,
            _ => null
        };
        _items = await Loads.SearchAsync(driverId, from, to, _filterLoadId, verified);
    }

    private async Task OpenCreateAsync()
    {
        _createLoadId = "";
        _createDriverId = "0";
        _createNotes = "";
        _createRate = 575m;
        _createTruck = "";
        _createLoadDate = DateTime.Today;
        foreach (var s in _docSlots) s.File = null;

        var defaultBillTo = await Loads.GetDefaultBillToCompanyIdAsync(
            recordedByUserId: CurrentUser.UserId);
        _createBillToId = defaultBillTo?.ToString() ?? "0";

        _showCreate = true;
    }

    private async Task CopyDriverLinkAsync(string link)
    {
        if (string.IsNullOrWhiteSpace(link)) return;
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", link);
            Toasts.Success("Enlace del chofer copiado.");
        }
        catch
        {
            Toasts.Error("No se pudo copiar. Selecciona el enlace y cópialo manualmente.");
        }
    }

    private void CloseCreate() => _showCreate = false;

    private void OnCreateDocSelected(RecycleDocumentType type, InputFileChangeEventArgs e)
    {
        var slot = _docSlots.First(s => s.Type == type);
        slot.File = e.File;
    }

    private async Task SaveCreateAsync()
    {
        if (!int.TryParse(_createDriverId, out var driverId) || driverId <= 0)
        {
            Toasts.Error("Selecciona un chofer.");
            return;
        }

        if (!int.TryParse(_createBillToId, out var billToId) || billToId <= 0)
        {
            Toasts.Error("Selecciona la compañía a la que se vendió la carga.");
            return;
        }

        if (_createLoadDate is null)
        {
            Toasts.Error("Selecciona la fecha de carga.");
            return;
        }

        if (_docSlots.Any(s => s.File is null))
        {
            Toasts.Error("Sube BOL, NUCOR y SCALE.");
            return;
        }

        try
        {
            await Busy.RunAsync(async () =>
            {
                var load = await Loads.CreateLoadAsync(
                    _createLoadId,
                    driverId,
                    _createNotes,
                    recordedByStaff: true,
                    billToCompanyId: billToId,
                    rateUsd: _createRate,
                    truckNumber: _createTruck,
                    loadDate: DateOnly.FromDateTime(_createLoadDate.Value));
                foreach (var slot in _docSlots)
                {
                    await using var stream = slot.File!.OpenReadStream(8 * 1024 * 1024);
                    var path = await Media.SaveAsync(stream, slot.File.Name, "recycle", load.Id, DocLabel(slot.Type));
                    await Loads.AttachDocumentAsync(load.Id, slot.Type, path);
                }

                await Loads.EnsureCompleteDocumentsAsync(load.Id);
                await Loads.SetVerifiedAsync(load.Id, true);
                await LoadItemsAsync();
            }, "Guardando carga…");

            _showCreate = false;
            Toasts.Success("Carga registrada y verificada.");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
            _error = ex.Message;
        }
    }

    private void OpenDetail(RecycleLoad l)
    {
        _detail = l;
        _editLoadId = l.LoadExternalId;
        _editDriverId = l.DriverUserId.ToString();
        _editBillToId = l.BillToCompanyId.ToString();
        _editNotes = l.Notes ?? "";
        _editRate = l.RateUsd;
        _editTruck = l.TruckNumber ?? "";
        _editLoadDate = l.LoadDate.ToDateTime(TimeOnly.MinValue);
    }

    private async Task SaveDetailMetaAsync()
    {
        if (_detail is null) return;
        if (!int.TryParse(_editDriverId, out var driverId) || driverId <= 0)
        {
            Toasts.Error("Selecciona un chofer.");
            return;
        }

        if (!int.TryParse(_editBillToId, out var billToId) || billToId <= 0)
        {
            Toasts.Error("Selecciona la compañía a la que se vendió la carga.");
            return;
        }

        if (_editLoadDate is null)
        {
            Toasts.Error("Selecciona la fecha de carga.");
            return;
        }

        try
        {
            await Busy.RunAsync(async () =>
            {
                await Loads.UpdateLoadMetaAsync(
                    _detail.Id,
                    _editLoadId,
                    driverId,
                    _editNotes,
                    _editRate,
                    _editTruck,
                    DateOnly.FromDateTime(_editLoadDate.Value),
                    billToId);
                _detail = await Loads.GetByIdAsync(_detail.Id);
                if (_detail is not null)
                    OpenDetail(_detail);
                await LoadItemsAsync();
            }, "Guardando datos…");
            Toasts.Success("Datos de la carga actualizados.");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task VerifyAsync(int id, bool verified)
    {
        try
        {
            await Busy.RunAsync(async () =>
            {
                await Loads.SetVerifiedAsync(id, verified);
                await LoadItemsAsync();
                if (_detail?.Id == id)
                {
                    _detail = await Loads.GetByIdAsync(id);
                    if (_detail is not null)
                        OpenDetail(_detail);
                }
            }, "Actualizando…");
            Toasts.Success(verified ? "Marcada como verificada." : "Verificación quitada.");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task ReplaceDocAsync(RecycleDocumentType type, InputFileChangeEventArgs e)
    {
        if (_detail is null) return;
        var file = e.File;
        try
        {
            await Busy.RunAsync(async () =>
            {
                await using var stream = file.OpenReadStream(8 * 1024 * 1024);
                var path = await Media.SaveAsync(stream, file.Name, "recycle", _detail.Id, DocLabel(type));
                await Loads.ReplaceDocumentAsync(_detail.Id, type, path);
                _detail = await Loads.GetByIdAsync(_detail.Id);
                if (_detail is not null)
                    OpenDetail(_detail);
                await LoadItemsAsync();
            }, "Reemplazando documento…");
            Toasts.Success($"{DocLabel(type)} actualizado. Queda pendiente de verificación.");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task DeleteDetailAsync()
    {
        if (_detail is null) return;
        try
        {
            var id = _detail.Id;
            await Busy.RunAsync(async () =>
            {
                await Loads.DeleteAsync(id);
                await LoadItemsAsync();
            }, "Eliminando…");
            _detail = null;
            Toasts.Success("Carga eliminada.");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private void OpenBillToCreate()
    {
        _billToEditId = null;
        _billToAlias = "";
        _billToName = "";
        _billToAddress = "";
        _billToContact = "";
        _billToActive = true;
        _showBillTo = true;
    }

    private void OpenBillToEdit(RecycleBillToCompany c)
    {
        _billToEditId = c.Id;
        _billToAlias = c.Alias;
        _billToName = c.CompanyName;
        _billToAddress = c.AddressLine;
        _billToContact = c.ContactLine ?? "";
        _billToActive = c.IsActive;
        _showBillTo = true;
    }

    private async Task SaveBillToAsync()
    {
        try
        {
            await Busy.RunAsync(async () =>
            {
                await Invoices.UpsertBillToAsync(
                    _billToEditId,
                    _billToAlias,
                    _billToName,
                    _billToAddress,
                    _billToContact,
                    _billToActive);
                await LoadInvoicePanelsAsync();
            }, "Guardando compañía…");
            _showBillTo = false;
            Toasts.Success("Compañía BILL TO guardada.");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private void SelectLastWeek()
    {
        var (monday, friday) = RecycleInvoiceService.GetLastCompletedWorkWeek();
        _invoiceMonday = monday;
        _invoiceFriday = friday;
        _invoicePickDate = monday.ToDateTime(TimeOnly.MinValue);
        _needReplacePassword = false;
        _replacePassword = "";
    }

    private void SnapInvoiceWeek()
    {
        if (_invoicePickDate is null)
        {
            _invoiceMonday = null;
            _invoiceFriday = null;
            return;
        }

        var (monday, friday) = RecycleInvoiceService.GetWorkWeek(DateOnly.FromDateTime(_invoicePickDate.Value));
        _invoiceMonday = monday;
        _invoiceFriday = friday;
        _needReplacePassword = false;
        _replacePassword = "";
    }

    private async Task GenerateInvoiceAsync()
    {
        if (!int.TryParse(_invoiceBillToId, out var billToId) || billToId <= 0)
        {
            Toasts.Error("Selecciona una compañía BILL TO.");
            return;
        }

        if (_invoiceMonday is null || _invoiceFriday is null)
        {
            Toasts.Error("Selecciona la semana.");
            return;
        }

        var monday = _invoiceMonday.Value;
        var friday = _invoiceFriday.Value;

        try
        {
            var existing = await Invoices.GetInvoiceForWeekAsync(monday, billToId);
            if (existing is not null && string.IsNullOrWhiteSpace(_replacePassword))
            {
                _needReplacePassword = true;
                Toasts.Error("Ya existe un invoice para esa semana y compañía. Ingresa tu contraseña para reemplazarlo.");
                return;
            }

            await Busy.RunAsync(async () =>
            {
                var invoiceDate = YardTimeZone.TodayEastern();
                await Invoices.CreateOrReplaceWeekAsync(
                    monday,
                    friday,
                    billToId,
                    invoiceDate,
                    existing is not null ? _replacePassword : null,
                    async (num, billTo, loads) =>
                    {
                        var bytes = InvoicePdf.GeneratePdf(num, invoiceDate, monday, friday, billTo, loads);
                        var path = await Media.SaveRecycleInvoicePdfAsync(num, bytes);
                        return (path, loads.Sum(l => l.RateUsd), loads.Count);
                    });

                await LoadInvoicePanelsAsync();
            }, "Generando invoice…");

            _needReplacePassword = false;
            _replacePassword = "";
            Toasts.Success("Invoice semanal generado.");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
            _error = ex.Message;
        }
    }

    private async Task DownloadInvoiceAsync(RecycleWeeklyInvoice inv)
    {
        try
        {
            var bytes = Media.TryReadBytes(inv.PdfRelativePath);
            if (bytes is null || bytes.Length == 0)
            {
                Toasts.Error("No se encontró el archivo PDF.");
                return;
            }

            await Js.InvokeVoidAsync(
                "rsyDownloadFile",
                $"recycle-invoice-{inv.InvoiceNumber}.pdf",
                "application/pdf",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private void AskDeleteInvoice(RecycleWeeklyInvoice inv) => _deleteInvoiceTarget = inv;

    private static string PaymentBadgeClass(RecycleInvoicePaymentStatus status) => status switch
    {
        RecycleInvoicePaymentStatus.Paid => "badge-status--ok",
        RecycleInvoicePaymentStatus.AmountMismatch => "badge-status--warn",
        _ => "badge-status--muted"
    };

    private void OpenPaymentModal(RecycleWeeklyInvoice inv)
    {
        _paymentError = null;
        _paymentInvoice = inv;
        _paymentPendingFile = null;
        if (inv.Payment is not null)
        {
            _paymentCheckDate = inv.Payment.CheckDate.ToDateTime(TimeOnly.MinValue);
            _paymentAmount = inv.Payment.AmountUsd;
            _paymentNotes = inv.Payment.Notes;
            _paymentImagePath = inv.Payment.CheckImageRelativePath;
        }
        else
        {
            _paymentCheckDate = DateTime.Today;
            _paymentAmount = inv.TotalAmountUsd;
            _paymentNotes = null;
            _paymentImagePath = null;
        }
    }

    private void ClosePaymentModal()
    {
        _paymentInvoice = null;
        _paymentPendingFile = null;
        _paymentError = null;
    }

    private void OnPaymentImageSelected(InputFileChangeEventArgs e)
    {
        _paymentError = null;
        _paymentPendingFile = e.FileCount > 0 ? e.File : null;
    }

    private async Task OpenPaymentImage()
    {
        if (string.IsNullOrWhiteSpace(_paymentImagePath) || _viewer is null) return;
        await _viewer.OpenAsync([_paymentImagePath], 0);
    }

    private async Task SavePaymentAsync()
    {
        if (_paymentInvoice is null || Busy.IsBusy) return;
        _paymentError = null;
        try
        {
            if (_paymentCheckDate is null)
                throw new InvalidOperationException("Indica la fecha del cheque.");
            if (_paymentAmount is null or <= 0)
                throw new InvalidOperationException("Indica el monto del cheque.");
            if (_paymentPendingFile is null && string.IsNullOrWhiteSpace(_paymentImagePath))
                throw new InvalidOperationException("Sube la imagen del cheque.");

            await Busy.RunAsync(async () =>
            {
                var imagePath = _paymentImagePath;
                string? oldPath = _paymentInvoice.Payment?.CheckImageRelativePath;

                if (_paymentPendingFile is not null)
                {
                    await using var stream = _paymentPendingFile.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024);
                    imagePath = await Media.SaveAsync(
                        stream,
                        _paymentPendingFile.Name,
                        "recycle-payments",
                        _paymentInvoice.Id,
                        _paymentInvoice.BillToCompany?.Alias ?? "check");
                }

                await Invoices.UpsertPaymentAsync(
                    _paymentInvoice.Id,
                    imagePath!,
                    DateOnly.FromDateTime(_paymentCheckDate.Value),
                    _paymentAmount.Value,
                    _paymentNotes);

                if (oldPath is not null
                    && imagePath is not null
                    && !string.Equals(oldPath, imagePath, StringComparison.OrdinalIgnoreCase))
                {
                    Media.TryDelete(oldPath);
                }

                await LoadInvoicePanelsAsync();
            }, "Guardando pago…");

            ClosePaymentModal();
            Toasts.Success("Pago del invoice registrado.");
        }
        catch (Exception ex)
        {
            _paymentError = ex.Message;
            Toasts.Error(ex.Message);
        }
    }

    private async Task ConfirmDeleteInvoiceAsync()
    {
        if (_deleteInvoiceTarget is null) return;
        var inv = _deleteInvoiceTarget;
        try
        {
            await Busy.RunAsync(async () =>
            {
                var path = await Invoices.DeleteInvoiceAsync(inv.Id);
                Media.TryDelete(path);
                await LoadInvoicePanelsAsync();
            }, "Eliminando invoice…");

            _deleteInvoiceTarget = null;
            _needReplacePassword = false;
            _replacePassword = "";
            Toasts.Success($"Invoice #{inv.InvoiceNumber} eliminado.");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
            _error = ex.Message;
        }
    }

    private static string DocLabel(RecycleDocumentType t) => t switch
    {
        RecycleDocumentType.Bol => "BOL",
        RecycleDocumentType.Nucor => "NUCOR",
        RecycleDocumentType.Scale => "SCALE",
        _ => t.ToString()
    };

    private IEnumerable<RecycleBillToCompany> BillToOptionsForEdit()
    {
        var active = _billToCompanies.Where(c => c.IsActive);
        if (_detail is null) return active;
        var current = _billToCompanies.FirstOrDefault(c => c.Id == _detail.BillToCompanyId);
        if (current is null || current.IsActive) return active;
        return active.Prepend(current);
    }

    private sealed class DocSlot(RecycleDocumentType type, string label)
    {
        public RecycleDocumentType Type { get; } = type;
        public string Label { get; } = label;
        public IBrowserFile? File { get; set; }
    }
}
