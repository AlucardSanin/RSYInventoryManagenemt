@page "/recycle/loads"
@inject RecycleLoadService Loads
@inject RecycleInvoiceService Invoices
@inject RecycleWeeklyInvoicePdfService InvoicePdf
@inject MediaStorageService Media
@inject ICurrentUserService CurrentUser
@inject UiBusyService Busy
@inject ToastService Toasts
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Agenda de reciclaje</PageTitle>

<PageHeader Title="Agenda de reciclaje"
            Eyebrow="Chatarra"
            Lead="Consulta cargas por chofer y fecha. Al registrar, elige la compañía a la que se vendió. El invoice semanal solo imprime las cargas de esa compañía.">
    @if (CurrentUser.CanManageScrapLogistics)
    {
        <button type="button" class="btn btn-primary" @onclick="OpenCreateAsync">Registrar carga</button>
    }
</PageHeader>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (!CurrentUser.CanManageScrapLogistics)
{
    <div class="alert alert-warning">No tienes permiso para la agenda de reciclaje.</div>
}
else if (_items is null)
{
    <div class="page-panel"><p class="mb-0 text-muted">Cargando…</p></div>
}
else
{
    <div class="page-panel mb-3">
        <h2 class="page-panel__title">Enlaces de choferes de reciclaje</h2>
        <p class="form-hint mb-3">Copia y envía el enlace al chofer. Entra sin contraseña para registrar cargas (BOL, NUCOR, SCALE).</p>
        @if (_drivers.Count == 0)
        {
            <p class="mb-0 text-muted">No hay usuarios con rol Chofer reciclaje. Créalos en Usuarios.</p>
        }
        else
        {
            <div class="table-shell">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Chofer</th>
                            <th>Enlace</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _drivers)
                        {
                            var link = d.DriverAccessToken is Guid token
                                ? Nav.ToAbsoluteUri($"r/{token}").ToString()
                                : null;
                            <tr>
                                <td><strong>@d.DisplayName</strong></td>
                                <td>
                                    @if (link is null)
                                    {
                                        <span class="text-muted">Sin enlace — regenera en Usuarios</span>
                                    }
                                    else
                                    {
                                        <div class="form-hint mono" style="max-width:28rem;word-break:break-all">@link</div>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (link is not null)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => CopyDriverLinkAsync(link)">Copiar enlace</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="page-panel mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="page-panel__title mb-0">Compañías BILL TO</h2>
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenBillToCreate">Nueva</button>
        </div>
        @if (_billToCompanies.Count == 0)
        {
            <p class="mb-0 text-muted">No hay compañías. Crea una para generar invoices.</p>
        }
        else
        {
            <div class="table-shell">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Alias</th>
                            <th>Nombre</th>
                            <th>Dirección</th>
                            <th>Activa</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _billToCompanies)
                        {
                            <tr>
                                <td><strong>@c.Alias</strong></td>
                                <td>@c.CompanyName</td>
                                <td>@c.AddressLine</td>
                                <td>@(c.IsActive ? "Sí" : "No")</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => OpenBillToEdit(c)">Editar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="page-panel mb-3">
        <h2 class="page-panel__title">Invoice semanal</h2>
        <p class="form-hint mb-2">Elige la compañía para imprimir solo las cargas de esa semana registradas para ella.</p>
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Compañía (filtro)</label>
                <select class="form-select" @bind="_invoiceBillToId">
                    <option value="0">Seleccionar…</option>
                    @foreach (var c in _billToCompanies.Where(x => x.IsActive))
                    {
                        <option value="@c.Id">@c.Alias — @c.CompanyName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Fecha (semana)</label>
                <InputDate class="form-control" @bind-Value="_invoicePickDate" @bind-Value:after="SnapInvoiceWeek" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Semana seleccionada</label>
                <div class="form-control-plaintext">
                    @if (_invoiceMonday is not null && _invoiceFriday is not null)
                    {
                        <span>@_invoiceMonday.Value.ToString("yyyy-MM-dd") → @_invoiceFriday.Value.ToString("yyyy-MM-dd")</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-outline-secondary" @onclick="SelectLastWeek">Última semana</button>
                <button type="button" class="btn btn-primary" disabled="@Busy.IsBusy" @onclick="GenerateInvoiceAsync">Generar PDF</button>
            </div>
        </div>
        @if (_needReplacePassword)
        {
            <div class="row g-2 align-items-end mt-2">
                <div class="col-md-4">
                    <label class="form-label">Contraseña para reemplazar invoice</label>
                    <input class="form-control" type="password" @bind="_replacePassword" autocomplete="current-password" />
                </div>
                <div class="col-md-4">
                    <div class="form-hint">Ya existe un invoice para esa semana y compañía. Confirma con tu contraseña y vuelve a generar.</div>
                </div>
            </div>
        }
    </div>

    <div class="page-panel mb-3">
        <h2 class="page-panel__title">Invoices guardados</h2>
        @if (_invoices.Count == 0)
        {
            <p class="mb-0 text-muted">Aún no hay invoices generados.</p>
        }
        else
        {
            <div class="table-shell">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Semana</th>
                            <th>BILL TO</th>
                            <th>Total</th>
                            <th>Pago</th>
                            <th>Generado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in _invoices)
                        {
                            var payStatus = RecycleInvoiceService.ResolvePaymentStatus(inv.TotalAmountUsd, inv.Payment);
                            <tr>
                                <td><code>@inv.InvoiceNumber</code></td>
                                <td>@inv.WeekStartDate.ToString("yyyy-MM-dd") → @inv.WeekEndDate.ToString("yyyy-MM-dd")</td>
                                <td>@(inv.BillToCompany?.Alias ?? "—")</td>
                                <td>@UsdMoney.Format(inv.TotalAmountUsd)</td>
                                <td>
                                    <span class="badge-status @PaymentBadgeClass(payStatus)">
                                        @RecycleInvoiceService.FormatPaymentStatus(payStatus)
                                    </span>
                                    @if (inv.Payment is not null)
                                    {
                                        <div class="form-hint mb-0">
                                            Cheque @UsdMoney.Format(inv.Payment.AmountUsd)
                                            · @inv.Payment.CheckDate.ToString("yyyy-MM-dd")
                                        </div>
                                    }
                                </td>
                                <td>@YardTimeZone.ToEastern(inv.GeneratedAtUtc).ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary" href="@inv.PdfRelativePath" target="_blank" rel="noopener">Ver PDF</a>
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            @onclick="() => DownloadInvoiceAsync(inv)">Descargar</button>
                                    <button type="button" class="btn btn-sm btn-outline-success"
                                            disabled="@Busy.IsBusy"
                                            @onclick="() => OpenPaymentModal(inv)">
                                        @(inv.Payment is null ? "Registrar pago" : "Editar pago")
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            disabled="@Busy.IsBusy"
                                            @onclick="() => AskDeleteInvoice(inv)">Eliminar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="page-panel mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Chofer</label>
                <select class="form-select" @bind="_filterDriverId">
                    <option value="0">Todos</option>
                    @foreach (var d in _drivers)
                    {
                        <option value="@d.Id">@d.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Desde</label>
                <InputDate class="form-control" @bind-Value="_filterFrom" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta</label>
                <InputDate class="form-control" @bind-Value="_filterTo" />
            </div>
            <div class="col-md-2">
                <label class="form-label">ID carga</label>
                <input class="form-control" @bind="_filterLoadId" placeholder="Ej. 12345" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Estado</label>
                <select class="form-select" @bind="_filterVerified">
                    <option value="">Todos</option>
                    <option value="pending">Sin verificar</option>
                    <option value="ok">Verificado</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="button" class="btn btn-outline-primary w-100" disabled="@Busy.IsBusy" @onclick="ReloadAsync">Filtrar</button>
            </div>
        </div>
    </div>

    <div class="page-panel table-shell">
        @if (_items.Count == 0)
        {
            <p class="mb-0 text-muted">Sin cargas para ese filtro.</p>
        }
        else
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID carga</th>
                        <th>Compañía</th>
                        <th>Chofer</th>
                        <th>Fecha</th>
                        <th>Camión</th>
                        <th>Precio</th>
                        <th>Registrado (ET)</th>
                        <th>Docs</th>
                        <th>Registró</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in _items)
                    {
                        <tr>
                            <td><code>@l.LoadExternalId</code></td>
                            <td>@(l.BillToCompany?.Alias ?? "—")</td>
                            <td>@l.Driver.DisplayName</td>
                            <td>@l.LoadDate.ToString("yyyy-MM-dd")</td>
                            <td>@(l.TruckNumber ?? "—")</td>
                            <td>@UsdMoney.Format(l.RateUsd)</td>
                            <td>@YardTimeZone.ToEastern(l.RecordedAtUtc).ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@l.Documents.Count / 3</td>
                            <td>@l.RecordedByUser.DisplayName</td>
                            <td>
                                @if (l.IsVerified)
                                {
                                    <span class="badge-status badge-status--ok">Verificado</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status--warn">Pendiente por verificación</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OpenDetail(l)">Ver</button>
                                @if (!l.IsVerified)
                                {
                                    <button type="button" class="btn btn-sm btn-success" disabled="@Busy.IsBusy"
                                            @onclick="() => VerifyAsync(l.Id, true)">Verificar</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning" disabled="@Busy.IsBusy"
                                            @onclick="() => VerifyAsync(l.Id, false)">Quitar verif.</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (_showCreate)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">Registrar carga</h2>
                    <button type="button" class="btn-close" @onclick="CloseCreate"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">ID de la carga *</label>
                            <input class="form-control" @bind="_createLoadId" placeholder="ID en los papeles" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Chofer *</label>
                            <select class="form-select" @bind="_createDriverId">
                                <option value="0">Seleccionar…</option>
                                @foreach (var d in _drivers)
                                {
                                    <option value="@d.Id">@d.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Compañía (vendido a) *</label>
                            <select class="form-select" @bind="_createBillToId">
                                <option value="0">Seleccionar…</option>
                                @foreach (var c in _billToCompanies.Where(x => x.IsActive))
                                {
                                    <option value="@c.Id">@c.Alias — @c.CompanyName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Precio (USD) *</label>
                            <input class="form-control" type="number" step="0.01" min="0.01" @bind="_createRate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Camión</label>
                            <input class="form-control" @bind="_createTruck" placeholder="Nº camión" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha de carga *</label>
                            <InputDate class="form-control" @bind-Value="_createLoadDate" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notas</label>
                            <textarea class="form-control" rows="2" @bind="_createNotes"></textarea>
                        </div>
                        @foreach (var doc in _docSlots)
                        {
                            <div class="col-md-4">
                                <label class="form-label">@doc.Label *</label>
                                <InputFile class="form-control"
                                           accept="image/*" capture="environment"
                                           OnChange="e => OnCreateDocSelected(doc.Type, e)" />
                                <div class="form-hint mt-1">@(doc.File?.Name ?? "Cámara o galería")</div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseCreate">Cancelar</button>
                    <button type="button" class="btn btn-primary" disabled="@Busy.IsBusy" @onclick="SaveCreateAsync">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_detail is not null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">Carga @_detail.LoadExternalId</h2>
                    <button type="button" class="btn-close" @onclick="() => _detail = null"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">ID de la carga</label>
                            <input class="form-control" @bind="_editLoadId" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Chofer</label>
                            <select class="form-select" @bind="_editDriverId">
                                @foreach (var d in _drivers)
                                {
                                    <option value="@d.Id">@d.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Compañía (vendido a)</label>
                            <select class="form-select" @bind="_editBillToId">
                                @foreach (var c in BillToOptionsForEdit())
                                {
                                    <option value="@c.Id">@c.Alias — @c.CompanyName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Precio (USD)</label>
                            <input class="form-control" type="number" step="0.01" min="0.01" @bind="_editRate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Camión</label>
                            <input class="form-control" @bind="_editTruck" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Fecha de carga</label>
                            <InputDate class="form-control" @bind-Value="_editLoadDate" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notas</label>
                            <textarea class="form-control" rows="2" @bind="_editNotes"></textarea>
                        </div>
                    </div>
                    <dl class="row">
                        <dt class="col-4">Registrado</dt>
                        <dd class="col-8">@YardTimeZone.ToEastern(_detail.RecordedAtUtc).ToString("yyyy-MM-dd HH:mm") ET</dd>
                        <dt class="col-4">Registró</dt>
                        <dd class="col-8">@_detail.RecordedByUser.DisplayName</dd>
                        <dt class="col-4">Estado</dt>
                        <dd class="col-8">
                            @(_detail.IsVerified ? "Verificado" : "Pendiente por verificación")
                        </dd>
                    </dl>
                    <div class="row g-3">
                        @foreach (var type in new[] { RecycleDocumentType.Bol, RecycleDocumentType.Nucor, RecycleDocumentType.Scale })
                        {
                            var doc = _detail.Documents.FirstOrDefault(d => d.DocumentType == (byte)type);
                            <div class="col-md-4">
                                <p class="fw-semibold mb-1">@DocLabel(type)</p>
                                @if (doc is not null)
                                {
                                    <a href="@doc.RelativePath" target="_blank" rel="noopener">
                                        <img class="thumb-img" style="width:100%;max-height:180px;object-fit:cover" src="@doc.RelativePath" alt="@DocLabel(type)" />
                                    </a>
                                }
                                else
                                {
                                    <p class="text-muted">Sin archivo</p>
                                }
                                <InputFile class="form-control form-control-sm mt-2"
                                           accept="image/*" capture="environment"
                                           OnChange="e => ReplaceDocAsync(type, e)" />
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" disabled="@Busy.IsBusy" @onclick="DeleteDetailAsync">Eliminar</button>
                    <button type="button" class="btn btn-primary" disabled="@Busy.IsBusy" @onclick="SaveDetailMetaAsync">Guardar datos</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _detail = null">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showBillTo)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">@(_billToEditId is null ? "Nueva compañía BILL TO" : "Editar compañía BILL TO")</h2>
                    <button type="button" class="btn-close" @onclick="() => _showBillTo = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Alias *</label>
                        <input class="form-control" @bind="_billToAlias" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre *</label>
                        <input class="form-control" @bind="_billToName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Dirección *</label>
                        <textarea class="form-control" rows="2" @bind="_billToAddress"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contacto</label>
                        <input class="form-control" @bind="_billToContact" />
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="billToActive" @bind="_billToActive" />
                        <label class="form-check-label" for="billToActive">Activa</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _showBillTo = false">Cancelar</button>
                    <button type="button" class="btn btn-primary" disabled="@Busy.IsBusy" @onclick="SaveBillToAsync">Guardar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_deleteInvoiceTarget is not null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">Eliminar invoice #@_deleteInvoiceTarget.InvoiceNumber</h2>
                    <button type="button" class="btn-close" @onclick="() => _deleteInvoiceTarget = null"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        ¿Eliminar el invoice #@_deleteInvoiceTarget.InvoiceNumber
                        (@_deleteInvoiceTarget.WeekStartDate.ToString("yyyy-MM-dd") → @_deleteInvoiceTarget.WeekEndDate.ToString("yyyy-MM-dd"),
                        @(_deleteInvoiceTarget.BillToCompany?.Alias ?? "—"))?
                        Podrás volver a generarlo; el número se reutiliza cuando corresponde.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _deleteInvoiceTarget = null">Cancelar</button>
                    <button type="button" class="btn btn-danger" disabled="@Busy.IsBusy" @onclick="ConfirmDeleteInvoiceAsync">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_paymentInvoice is not null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">
                        Pago invoice #@_paymentInvoice.InvoiceNumber
                        · @UsdMoney.Format(_paymentInvoice.TotalAmountUsd)
                    </h2>
                    <button type="button" class="btn-close" @onclick="ClosePaymentModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_paymentError))
                    {
                        <div class="alert alert-danger py-2">@_paymentError</div>
                    }
                    <p class="text-muted small mb-3">
                        Semana @_paymentInvoice.WeekStartDate.ToString("yyyy-MM-dd") → @_paymentInvoice.WeekEndDate.ToString("yyyy-MM-dd")
                        · BILL TO @(_paymentInvoice.BillToCompany?.Alias ?? "—")
                    </p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Fecha del cheque *</label>
                            <InputDate class="form-control" @bind-Value="_paymentCheckDate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Monto del cheque (USD) *</label>
                            <UsdMoneyInput InputId="payment-amount" @bind-Value="_paymentAmount" Placeholder="2300.00" />
                            @if (_paymentAmount is > 0
                                 && Math.Round(_paymentAmount.Value, 2) != Math.Round(_paymentInvoice.TotalAmountUsd, 2))
                            {
                                <div class="form-hint text-warning mb-0">
                                    El monto difiere del invoice (@UsdMoney.Format(_paymentInvoice.TotalAmountUsd)). Se guardará como “Monto distinto”.
                                </div>
                            }
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Imagen del cheque *</label>
                            <InputFile class="form-control" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
                                       OnChange="OnPaymentImageSelected" />
                            @if (!string.IsNullOrWhiteSpace(_paymentImagePath))
                            {
                                <div class="mt-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => OpenPaymentImage()">Ver imagen actual</button>
                                </div>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label">Nota <span class="form-hint">(opcional)</span></label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_paymentNotes" />
                        </div>
                        @if (_paymentInvoice.Payment is not null)
                        {
                            <div class="col-12">
                                <div class="form-hint mb-0">
                                    Registrado en plataforma:
                                    @YardTimeZone.ToEastern(_paymentInvoice.Payment.RecordedAtUtc).ToString("yyyy-MM-dd HH:mm")
                                    · @(_paymentInvoice.Payment.RecordedByUser?.DisplayName ?? "usuario")
                                    @if (_paymentInvoice.Payment.UpdatedAtUtc is not null)
                                    {
                                        <span>
                                            · actualizado
                                            @YardTimeZone.ToEastern(_paymentInvoice.Payment.UpdatedAtUtc.Value).ToString("yyyy-MM-dd HH:mm")
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="ClosePaymentModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" disabled="@Busy.IsBusy" @onclick="SavePaymentAsync">
                        Guardar pago
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<ImageViewer @ref="_viewer" />

@code {
    private List<RecycleLoad>? _items;
    private List<User> _drivers = [];
    private List<RecycleBillToCompany> _billToCompanies = [];
    private List<RecycleWeeklyInvoice> _invoices = [];
