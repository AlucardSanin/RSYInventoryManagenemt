@page "/vehicles/{Id:int}/assign"
@inject VehicleService Vehicles
@inject YardLayoutService Layout
@inject UiBusyService Busy
@inject NavigationManager Nav

<PageTitle>Asignar ubicación</PageTitle>

<PageHeader Title="Asignar ubicación"
            Eyebrow="Vehículos"
            Lead="Elige una paleta en una zona de vehículos.">
    <a class="btn btn-outline-secondary" href="vehicles">Volver</a>
</PageHeader>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_vehicle is null && string.IsNullOrEmpty(_error))
{
    <div class="page-panel"><p class="mb-0 text-muted">Cargando vehículo…</p></div>
}
else if (_vehicle is not null)
{
    <div class="page-panel">
        <p class="mb-1"><code>@_vehicle.Vin</code></p>
        <p class="mb-2"><strong>@_vehicle.Year @_vehicle.Make @_vehicle.Model</strong></p>
        <p class="meta-row mb-0">
            Ubicación actual:
            @if (_vehicle.Pallet is null)
            {
                <span class="badge-status badge-status--warn">Sin ubicar</span>
            }
            else
            {
                <strong>@YardLayoutService.FormatPalletLabel(_vehicle.Pallet)</strong>
            }
        </p>
    </div>

    <div class="page-panel">
        <div class="mb-3">
            <label class="form-label" for="pallet-combo">Paleta (zonas de vehículos) *</label>
            <SearchableCombo InputId="pallet-combo"
                             Value="@PalletValue"
                             ValueChanged="OnPalletChangedAsync"
                             Options="_palletOptions"
                             Placeholder="Escribe para filtrar zona, fila o paleta…"
                             AllowCustom="false" />
            <div class="form-text">Solo paletas de zonas de <strong>vehículos</strong> (no partes).</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Notas <span class="form-hint">(opcional)</span></label>
            <input class="form-control" @bind="_notes" placeholder="Opcional" />
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" disabled="@_saving" @onclick="SaveAsync">
                @(_saving ? "Guardando…" : "Guardar ubicación")
            </button>
            <a class="btn btn-link" href="vehicles">Cancelar</a>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Vehicle? _vehicle;
    private List<Pallet> _pallets = [];
    private List<ComboOption> _palletOptions = [];
    private int _palletId;
    private string? _notes;
    private string? _error;
    private bool _saving;

    private string? PalletValue => _palletId <= 0 ? null : _palletId.ToString();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Busy.RunAsync(async () =>
            {
                _vehicle = await Vehicles.GetByIdAsync(Id);
                if (_vehicle is null)
                {
                    _error = "Vehículo no encontrado.";
                    return;
                }

                _pallets = await Layout.GetPalletsAsync(ZonePurpose.Vehicles);
                _palletOptions = _pallets
                    .Select(p =>
                    {
                        var label = YardLayoutService.FormatPalletLabel(p);
                        return new ComboOption(p.Id.ToString(), label, label);
                    })
                    .ToList();
                _palletId = _vehicle.PalletId ?? 0;
            }, "Cargando vehículo…");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private Task OnPalletChangedAsync(string? value)
    {
        _palletId = int.TryParse(value, out var id) ? id : 0;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (Busy.IsBusy || _saving) return;
        _error = null;
        _saving = true;
        try
        {
            await Busy.RunAsync(async () =>
            {
                if (_palletId <= 0)
                    throw new InvalidOperationException("Seleccione una paleta.");

                await Vehicles.AssignLocationAsync(Id, _palletId, _notes);
                Nav.NavigateTo("vehicles");
            }, "Guardando ubicación…");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
