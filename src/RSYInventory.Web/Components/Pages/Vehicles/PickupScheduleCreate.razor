@page "/vehicles/pickups/new"
@page "/vehicles/pickups/{Id:int}/edit"
@implements IDisposable
@inject PickupScheduleService Schedules
@inject VehicleService Vehicles
@inject VinLookupService VinLookup
@inject MediaStorageService Media
@inject UiBusyService Busy
@inject ToastService Toasts
@inject NavigationManager Nav
@inject ICurrentUserService CurrentUser
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>@(IsEdit ? "Editar recolección" : "Agendar recolección")</PageTitle>

<PageHeader Title="@(IsEdit ? "Editar recolección pendiente" : "Agendar recolección de vehículo")"
            Eyebrow="Vehículos"
            Lead="@(IsEdit
                ? "Solo se pueden editar recolecciones pendientes (aún no marcadas como recogidas)."
                : "VIN, datos del auto, fecha/ventana acordada con el vendedor y dirección. El chofer es opcional. En móvil el formulario va por pasos.")">
    <a class="btn btn-outline-secondary" href="vehicles/pickups">Volver a agenda</a>
</PageHeader>

@if (!CurrentUser.CanManagePickupSchedule)
{
    <div class="alert alert-danger">No tiene permiso para la agenda de recolección.</div>
}
else
{
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_info))
    {
        <div class="alert alert-info">@_info</div>
    }

    <div class="page-panel">
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <div class="form-stepper" data-step="@_mobileStep">
                <div class="form-stepper__progress" aria-hidden="true">
                    @for (var i = 1; i <= MobileStepCount; i++)
                    {
                        <span class="form-stepper__dot @(i == _mobileStep ? "is-active" : null) @(i < _mobileStep ? "is-done" : null)"></span>
                    }
                </div>
                <p class="form-stepper__label">Paso @_mobileStep de @MobileStepCount · @MobileStepTitle</p>

                @* 1 · VIN *@
                <div class="form-step @(_mobileStep == 1 ? "is-active" : null)">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">VIN *</label>
                            <InputText class="form-control mono" @bind-Value="_model.Vin" maxlength="17" placeholder="17 caracteres" />
                        </div>
                        <div class="col-md-4 d-flex flex-column justify-content-end">
                            <button type="button" class="btn btn-outline-primary w-100" @onclick="DecodeVinAsync" disabled="@Busy.IsBusy">Decodificar VIN</button>
                            @if (!string.IsNullOrEmpty(_vinHint))
                            {
                                <div class="vin-hint">@_vinHint</div>
                            }
                        </div>
                    </div>
                </div>

                @* 2 · Identificación del vehículo *@
                <div class="form-step @(_mobileStep == 2 ? "is-active" : null)">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label" for="year-combo">Año</label>
                            <SearchableCombo InputId="year-combo"
                                             Value="@YearValue"
                                             ValueChanged="OnYearChangedAsync"
                                             Options="_yearOptions"
                                             Placeholder="Escribe 201… o elige"
                                             EmptyHint="Elige un año de la lista"
                                             AllowCustom="false"
                                             MaxSuggestions="@VehicleYearCatalog.DropdownVisibleCount" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="make-combo">Marca</label>
                            <SearchableCombo InputId="make-combo"
                                             Value="@_model.Make"
                                             ValueChanged="OnMakeChangedAsync"
                                             Options="_makeOptions"
                                             Placeholder="@(_model.Year is null ? "Primero elige un año" : "Escribe M… o elige")"
                                             EmptyHint="@(_model.Year is null ? "Primero elige un año" : "Escribe para filtrar marcas")"
                                             Disabled="@(_model.Year is null)"
                                             AllowCustom="true" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="model-combo">Modelo</label>
                            <SearchableCombo InputId="model-combo"
                                             @bind-Value="_model.Model"
                                             Options="_modelOptions"
                                             Placeholder="@ModelPlaceholder"
                                             EmptyHint="@ModelEmptyHint"
                                             Disabled="@string.IsNullOrWhiteSpace(_model.Make)"
                                             AllowCustom="true"
                                             MaxSuggestions="50" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Millas <span class="form-hint">(opcional)</span></label>
                            <InputNumber class="form-control" @bind-Value="_model.Mileage" placeholder="Ej. 85000" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="trans-combo">Transmisión</label>
                            <SearchableCombo InputId="trans-combo"
                                             Value="@TransmissionValue"
                                             ValueChanged="OnTransmissionChangedAsync"
                                             Options="_transmissionOptions"
                                             Placeholder="Automática o manual"
                                             AllowCustom="false" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="drive-combo">Tracción</label>
                            <SearchableCombo InputId="drive-combo"
                                             Value="@DriveValue"
                                             ValueChanged="OnDriveChangedAsync"
                                             Options="_driveOptions"
                                             Placeholder="FWD, RWD, AWD…"
                                             AllowCustom="false" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="price-input">Precio de compra <span class="form-hint">(USD)</span></label>
                            <UsdMoneyInput InputId="price-input" @bind-Value="_model.PurchasePrice" Placeholder="2500.00" />
                            @if (_priceHistory.Count > 0)
                            {
                                <div class="price-history price-history--compact">
                                    <div class="price-history__title">Precios anteriores</div>
                                    <ul class="price-history__list">
                                        @foreach (var h in _priceHistory)
                                        {
                                            <li>
                                                <span class="price-history__change">
                                                    @UsdMoney.FormatOrDash(h.OldPrice)
                                                    <span aria-hidden="true">→</span>
                                                    @UsdMoney.FormatOrDash(h.NewPrice)
                                                </span>
                                                <span class="price-history__meta">
                                                    @h.ChangedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                                    · @(h.ChangedByUser?.DisplayName ?? "usuario")
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Método de pago <span class="form-hint">(opcional)</span></label>
                            <InputText class="form-control" @bind-Value="_model.PaymentMethod" placeholder="Cash, Zelle, Check…" />
                        </div>
                    </div>
                </div>

                @* 3 · Fuente y recogida *@
                <div class="form-step @(_mobileStep == 3 ? "is-active" : null)">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="source-combo">Fuente *</label>
                            <SearchableCombo InputId="source-combo"
                                             Value="@SourceValue"
                                             ValueChanged="OnSourceChangedAsync"
                                             Options="_sourceOptions"
                                             Placeholder="Wheelzy, Peddle…"
                                             AllowCustom="false" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Para ser recogido en *</label>
                            <InputDate class="form-control" @bind-Value="_model.ScheduledPickupDate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ventana de recolección <span class="form-hint">(opcional)</span></label>
                            <InputText class="form-control"
                                       @bind-Value="_model.ScheduledPickupWindow"
                                       maxlength="80"
                                       placeholder="Ej. 9 - 12pm" />
                            <div class="form-hint">Rango acordado con el vendedor, no una hora exacta.</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Dirección de recogida</label>
                            <InputTextArea class="form-control"
                                           @bind-Value="_model.PickupAddress"
                                           rows="3"
                                           maxlength="500"
                                           placeholder="Dirección completa donde el chofer recoge el auto" />
                        </div>
                    </div>
                </div>

                @* 4 · Vendedor y chofer *@
                <div class="form-step @(_mobileStep == 4 ? "is-active" : null)">
                    <div class="row g-3">
                        <div class="col-12">
                            <p class="form-hint mb-0">Contacto del vendedor y chofer (opcionales). Puedes dejar el chofer sin asignar y hacerlo después.</p>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Nombre del vendedor</label>
                            <InputText class="form-control" @bind-Value="_model.SellerName" placeholder="Nombre completo" autocomplete="name" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Teléfono</label>
                            <InputText class="form-control" @bind-Value="_model.SellerPhone" placeholder="Ej. 787-555-0100" autocomplete="tel" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Correo</label>
                            <InputText class="form-control" @bind-Value="_model.SellerEmail" placeholder="correo@ejemplo.com" autocomplete="email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="driver-combo">Chofer asignado <span class="form-hint">(opcional)</span></label>
                            <SearchableCombo InputId="driver-combo"
                                             Value="@DriverValue"
                                             ValueChanged="OnDriverChangedAsync"
                                             Options="_driverOptions"
                                             Placeholder="Sin asignar / elige chofer"
                                             EmptyHint="Escribe para filtrar choferes"
                                             AllowCustom="false" />
                        </div>
                    </div>
                </div>

                @* 5 · Fotos y notas *@
                <div class="form-step @(_mobileStep == 5 ? "is-active" : null)">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Fotos <span class="form-hint">(opcional)</span></label>
                            <InputFile class="form-control" OnChange="OnImagesSelected" accept=".jpg,.jpeg,.png,.webp,image/*" multiple />
                            <div class="image-upload-hint">JPG/PNG/WEBP · puedes seleccionar varias.</div>
                            @if (_imageFiles.Count > 0)
                            {
                                <div class="form-hint mt-1">@_imageFiles.Count foto(s): @string.Join(", ", _imageFiles.Select(f => f.Name))</div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Observaciones <span class="form-hint">(opcional)</span></label>
                            <InputTextArea class="form-control" @bind-Value="_model.Observations" rows="3" />
                        </div>
                    </div>
                </div>

                <div class="form-stepper__nav">
                    @if (_mobileStep > 1)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="PreviousStep" disabled="@Busy.IsBusy">Atrás</button>
                    }
                    @if (_mobileStep < MobileStepCount)
                    {
                        <button type="button" class="btn btn-primary" @onclick="NextStep" disabled="@Busy.IsBusy">Siguiente</button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-primary" disabled="@(_saving || Busy.IsBusy)">
                            @(_saving ? "Guardando…" : IsEdit ? "Guardar cambios" : "Guardar en agenda")
                        </button>
                    }
                </div>
            </div>

            <div class="form-actions form-actions--desktop">
                <button type="submit" class="btn btn-primary" disabled="@(_saving || Busy.IsBusy)">
                    @(_saving ? "Guardando…" : IsEdit ? "Guardar cambios" : "Guardar en agenda")
                </button>
                <a class="btn btn-link" href="vehicles/pickups">Cancelar</a>
            </div>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsEdit => Id is > 0;

    private const int MobileStepCount = 5;

    private static readonly IReadOnlyList<ComboOption> _transmissionOptions =
    [
        new(((int)TransmissionType.Automatic).ToString(), "Automática"),
        new(((int)TransmissionType.Manual).ToString(), "Manual")
    ];

    private static readonly IReadOnlyList<ComboOption> _driveOptions =
    [
        new(((int)VehicleDriveType.Fwd).ToString(), "FWD"),
        new(((int)VehicleDriveType.Rwd).ToString(), "RWD"),
        new(((int)VehicleDriveType.Awd).ToString(), "AWD"),
        new(((int)VehicleDriveType.FourByFour).ToString(), "4x4"),
        new(((int)VehicleDriveType.FourByTwo).ToString(), "4x2")
    ];

    private static readonly IReadOnlyList<ComboOption> _yearOptions =
        VehicleYearCatalog.AllYears.Select(y => new ComboOption(y, y)).ToList();

    private readonly ScheduleModel _model = new() { ScheduledPickupDate = YardTimeZone.TodayEastern() };
    private List<VehiclePriceHistory> _priceHistory = [];
    private List<VehicleSource> _sources = [];
    private List<ComboOption> _sourceOptions = [];
    private List<ComboOption> _makeOptions = [];
    private List<ComboOption> _modelOptions = [];
    private List<ComboOption> _driverOptions = [];
    private CancellationTokenSource? _modelLoadCts;
    private bool _loadingModels;
    private string? _error;
    private string? _info;
    private string? _vinHint;
    private bool _saving;
    private int _mobileStep = 1;
    private readonly List<IBrowserFile> _imageFiles = [];

    private string? YearValue => _model.Year?.ToString();
    private string? TransmissionValue => _model.TransmissionType is null ? null : ((int)_model.TransmissionType.Value).ToString();
    private string? DriveValue => _model.DriveType is null ? null : ((int)_model.DriveType.Value).ToString();
    private string? SourceValue => _model.VehicleSourceId <= 0 ? null : _model.VehicleSourceId.ToString();
    private string? DriverValue => _model.AssignedDriverUserId is > 0 ? _model.AssignedDriverUserId.Value.ToString() : null;

    private string MobileStepTitle => _mobileStep switch
    {
        1 => "VIN",
        2 => "Datos del vehículo",
        3 => "Fuente y recogida",
        4 => "Vendedor y chofer",
        _ => "Fotos y notas"
    };

    private string ModelPlaceholder =>
        _model.Year is null ? "Primero elige un año"
        : string.IsNullOrWhiteSpace(_model.Make) ? "Primero elige una marca"
        : _loadingModels ? "Cargando modelos…"
        : "Escribe Foc… o elige";

    private string ModelEmptyHint =>
        _model.Year is null ? "Primero elige un año"
        : string.IsNullOrWhiteSpace(_model.Make) ? "Primero elige una marca"
        : "Escribe para filtrar modelos";

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.CanManagePickupSchedule)
        {
            Nav.NavigateTo("vehicles/pickups");
            return;
        }

        try
        {
            await Busy.RunAsync(async () =>
            {
                _sources = await Vehicles.GetSourcesAsync();
                _sourceOptions = _sources.Select(s => new ComboOption(s.Id.ToString(), s.Name)).ToList();

                var makes = await Vehicles.GetDistinctMakesAsync();
                _makeOptions = makes.Select(m => new ComboOption(m, m)).ToList();

                var drivers = await Schedules.GetDriverUsersAsync();
                _driverOptions = drivers.Select(d => new ComboOption(d.Id.ToString(), d.DisplayName)).ToList();

                if (IsEdit)
                {
                    var existing = await Schedules.GetByIdAsync(Id!.Value)
                        ?? throw new InvalidOperationException("Agenda no encontrada.");
                    if (existing.Status != (byte)ScheduledPickupStatus.Pending)
                        throw new InvalidOperationException("Solo se pueden editar recolecciones pendientes.");

                    _model.Vin = existing.Vin;
                    _model.Year = existing.Year;
                    _model.Make = existing.Make;
                    _model.Model = existing.Model;
                    _model.TransmissionType = existing.TransmissionType is null
                        ? null
                        : (TransmissionType)existing.TransmissionType.Value;
                    _model.DriveType = existing.DriveType is null
                        ? null
                        : (VehicleDriveType)existing.DriveType.Value;
                    _model.Mileage = existing.Mileage;
                    _model.PurchasePrice = existing.PurchasePrice;
                    _model.PaymentMethod = existing.PaymentMethod;
                    _model.Observations = existing.Observations;
                    _model.PickupAddress = existing.PickupAddress;
                    _model.SellerName = existing.SellerName;
                    _model.SellerPhone = existing.SellerPhone;
                    _model.SellerEmail = existing.SellerEmail;
                    _model.AssignedDriverUserId = existing.AssignedDriverUserId;
                    _model.VehicleSourceId = existing.VehicleSourceId;
                    _model.ScheduledPickupDate = existing.ScheduledPickupDate;
                    _model.ScheduledPickupWindow = existing.ScheduledPickupWindow;
                    _priceHistory = (await Schedules.GetPriceHistoryAsync(Id!.Value)).ToList();
                }
                else
                {
                    _priceHistory = [];
                }

                if (!string.IsNullOrWhiteSpace(_model.Make) && _model.Year is not null)
                    await ReloadModelOptionsAsync();
            }, "Cargando formulario…");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    public void Dispose() => _modelLoadCts?.Cancel();

    private void PreviousStep()
    {
        _error = null;
        if (_mobileStep > 1) _mobileStep--;
    }

    private void NextStep()
    {
        _error = null;
        if (!ValidateCurrentStep(out var message))
        {
            _error = message;
            return;
        }

        if (_mobileStep < MobileStepCount)
            _mobileStep++;
    }

    private bool ValidateCurrentStep(out string? message)
    {
        message = null;
        switch (_mobileStep)
        {
            case 1 when string.IsNullOrWhiteSpace(_model.Vin):
                message = "Ingresa el VIN del vehículo.";
                return false;
            case 3 when _model.VehicleSourceId <= 0:
                message = "Selecciona la fuente (Wheelzy, Peddle, etc.).";
                return false;
            default:
                return true;
        }
    }

    private void OnImagesSelected(InputFileChangeEventArgs e)
    {
        _imageFiles.Clear();
        _imageFiles.AddRange(e.GetMultipleFiles(12));
    }

    private async Task OnYearChangedAsync(string? value)
    {
        var previous = _model.Year;
        _model.Year = int.TryParse(value, out var y) ? y : null;

        if (_model.Year != previous)
        {
            _model.Make = null;
            _model.Model = null;
            _modelOptions = [];
        }

        await Task.CompletedTask;
    }

    private async Task OnMakeChangedAsync(string? value)
    {
        var previous = _model.Make;
        _model.Make = value;
        if (!string.Equals(previous, value, StringComparison.OrdinalIgnoreCase))
            _model.Model = null;
        await ScheduleModelReloadAsync();
    }

    private Task OnTransmissionChangedAsync(string? value)
    {
        _model.TransmissionType = int.TryParse(value, out var n) ? (TransmissionType)n : null;
        return Task.CompletedTask;
    }

    private Task OnDriveChangedAsync(string? value)
    {
        _model.DriveType = int.TryParse(value, out var n) ? (VehicleDriveType)n : null;
        return Task.CompletedTask;
    }

    private Task OnSourceChangedAsync(string? value)
    {
        _model.VehicleSourceId = int.TryParse(value, out var id) ? id : 0;
        return Task.CompletedTask;
    }

    private Task OnDriverChangedAsync(string? value)
    {
        _model.AssignedDriverUserId = int.TryParse(value, out var id) && id > 0 ? id : null;
        return Task.CompletedTask;
    }

    private async Task ScheduleModelReloadAsync()
    {
        _modelLoadCts?.Cancel();
        _modelLoadCts = new CancellationTokenSource();
        var ct = _modelLoadCts.Token;

        try
        {
            await Task.Delay(350, ct);
            await ReloadModelOptionsAsync(ct);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task ReloadModelOptionsAsync(CancellationToken ct = default)
    {
        var make = _model.Make?.Trim();
        if (string.IsNullOrWhiteSpace(make) || _model.Year is null)
        {
            _modelOptions = [];
            _loadingModels = false;
            return;
        }

        _loadingModels = true;
        try
        {
            List<string> fromDb = [];
            try { fromDb = await Vehicles.GetDistinctModelsAsync(make, ct); } catch { }

            IReadOnlyList<string> fromApi = [];
            try { fromApi = await VinLookup.GetModelsForMakeAsync(make, _model.Year, ct); } catch { fromApi = []; }

            IEnumerable<string> mergedSource = fromApi.Count > 0 ? fromApi : fromDb;
            var merged = mergedSource
                .Where(m => !string.IsNullOrWhiteSpace(m))
                .Select(m => m.Trim())
                .GroupBy(m => m, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First())
                .OrderBy(m => m, StringComparer.OrdinalIgnoreCase)
                .Select(m => new ComboOption(m, m))
                .ToList();

            if (!string.IsNullOrWhiteSpace(_model.Model)
                && !merged.Any(o => string.Equals(o.Value, _model.Model, StringComparison.OrdinalIgnoreCase)))
            {
                merged.Insert(0, new ComboOption(_model.Model!, _model.Model!));
            }

            _modelOptions = merged;
        }
        catch
        {
            _modelOptions = [];
        }
        finally
        {
            _loadingModels = false;
        }
    }

    private async Task DecodeVinAsync()
    {
        if (Busy.IsBusy) return;
        _error = null;
        _info = null;
        _vinHint = null;

        try
        {
            await Busy.RunAsync(async () =>
            {
                VinDecodeResult result;
                try
                {
                    result = await VinLookup.DecodeAsync(_model.Vin);
                }
                catch (Exception ex)
                {
                    _error = $"No se pudo decodificar el VIN: {ex.Message}";
                    _vinHint = "¿Está bien el VIN?";
                    return;
                }

                try
                {
                    await ApplyVinDecodeAsync(result);
                }
                catch (Exception ex)
                {
                    _error = $"Se obtuvo el VIN pero falló al aplicar los datos: {ex.Message}";
                    _vinHint = "¿Está bien el VIN?";
                }
            }, "Decodificando VIN…");
        }
        catch (Exception ex)
        {
            _error = $"No se pudo decodificar el VIN: {ex.Message}";
            _vinHint = "¿Está bien el VIN?";
        }
    }

    private async Task ApplyVinDecodeAsync(VinDecodeResult result)
    {
        if (!string.IsNullOrWhiteSpace(result.Vin))
            _model.Vin = result.Vin;

        if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
        {
            _error = result.ErrorMessage;
            _vinHint = "¿Está bien el VIN?";
            return;
        }

        if (!result.HasAnyData)
        {
            _info = result.Warning
                    ?? "No se pudo decodificar este VIN. Completa año, marca y modelo manualmente.";
            _vinHint = "¿Está bien el VIN?";
            return;
        }

        if (result.Year is not null)
            _model.Year = result.Year;
        if (!string.IsNullOrWhiteSpace(result.Make))
            _model.Make = result.Make;
        if (!string.IsNullOrWhiteSpace(result.Model))
            _model.Model = result.Model;
        if (result.TransmissionType is not null)
            _model.TransmissionType = result.TransmissionType;
        if (result.DriveType is not null)
            _model.DriveType = result.DriveType;

        await ReloadModelOptionsAsync();

        _vinHint = null;
        _info = result.FromNhtsa
            ? "Se sugirieron campos desde el VIN (NHTSA). Puedes corregirlos."
            : result.Warning
              ?? "Solo se pudo sugerir año/marca de forma local. Completa el resto manualmente.";
    }

    private async Task SaveAsync()
    {
        if (Busy.IsBusy || _saving) return;
        _error = null;
        _saving = true;
        try
        {
            await Busy.RunAsync(async () =>
            {
                if (string.IsNullOrWhiteSpace(_model.Vin))
                    throw new InvalidOperationException("Ingresa el VIN.");
                if (_model.VehicleSourceId <= 0)
                    throw new InvalidOperationException("Seleccione una fuente.");

                int scheduleId;
                if (IsEdit)
                {
                    await Schedules.UpdatePendingAsync(
                        Id!.Value,
                        _model.Vin ?? string.Empty,
                        _model.Year,
                        _model.Make,
                        _model.Model,
                        _model.TransmissionType,
                        _model.DriveType,
                        _model.Mileage,
                        _model.PurchasePrice,
                        _model.Observations,
                        _model.VehicleSourceId,
                        _model.ScheduledPickupDate,
                        _model.ScheduledPickupWindow,
                        _model.PickupAddress,
                        _model.SellerName,
                        _model.SellerPhone,
                        _model.SellerEmail,
                        _model.PaymentMethod,
                        _model.AssignedDriverUserId);
                    scheduleId = Id.Value;
                }
                else
                {
                    var created = await Schedules.ScheduleAsync(
                        _model.Vin ?? string.Empty,
                        _model.Year,
                        _model.Make,
                        _model.Model,
                        _model.TransmissionType,
                        _model.DriveType,
                        _model.Mileage,
                        _model.PurchasePrice,
                        _model.Observations,
                        _model.VehicleSourceId,
                        _model.ScheduledPickupDate,
                        _model.ScheduledPickupWindow,
                        _model.PickupAddress,
                        _model.SellerName,
                        _model.SellerPhone,
                        _model.SellerEmail,
                        _model.PaymentMethod,
                        _model.AssignedDriverUserId);
                    scheduleId = created.Id;
                }

                if (_imageFiles.Count > 0)
                {
                    var failed = 0;
                    string? lastImageError = null;
                    foreach (var file in _imageFiles)
                    {
                        try
                        {
                            await using var stream = file.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024);
                            var path = await Media.SaveAsync(stream, file.Name, "pickups", scheduleId, _model.Make);
                            await Schedules.AddImageAsync(scheduleId, path);
                        }
                        catch (Exception imgEx)
                        {
                            failed++;
                            lastImageError = imgEx.Message;
                        }
                    }

                    if (failed > 0)
                    {
                        var detail = string.IsNullOrWhiteSpace(lastImageError) ? "" : $" ({lastImageError})";
                        Toasts.Info($"Recolección guardada, pero {failed} foto(s) no se pudieron subir{detail}.");
                    }
                    else
                        Toasts.Success(IsEdit ? "Recolección actualizada." : "Recolección agendada.");
                }
                else
                {
                    Toasts.Success(IsEdit ? "Recolección actualizada." : "Recolección agendada.");
                }
            }, IsEdit ? "Guardando cambios…" : "Guardando en agenda…");

            Nav.NavigateTo("vehicles/pickups");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class ScheduleModel
    {
        public string? Vin { get; set; }
        public int? Year { get; set; }
        public string? Make { get; set; }
        public string? Model { get; set; }
        public TransmissionType? TransmissionType { get; set; }
        public VehicleDriveType? DriveType { get; set; }
        public int? Mileage { get; set; }
        public decimal? PurchasePrice { get; set; }
        public string? PaymentMethod { get; set; }
        public string? Observations { get; set; }
        public string? PickupAddress { get; set; }
        public string? SellerName { get; set; }
        public string? SellerPhone { get; set; }
        public string? SellerEmail { get; set; }
        public int? AssignedDriverUserId { get; set; }
        public int VehicleSourceId { get; set; }
        public DateOnly ScheduledPickupDate { get; set; }
        public string? ScheduledPickupWindow { get; set; }
    }
}
