@page "/vehicles/pickups"
@inject PickupScheduleService Schedules
@inject ICurrentUserService CurrentUser
@inject UiBusyService Busy
@inject ToastService Toasts
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Agenda de recolección</PageTitle>

<PageHeader Title="Agenda de recolección de vehículos"
            Eyebrow="Trabajo diario"
            Lead="Programa recogidas, asigna chofer y genera reportes. Al marcar Recogido pasa de inmediato a Adquiridos; esos recogidos salen de esta agenda a la medianoche (hora NC).">
    @if (CurrentUser.CanManagePickupSchedule)
    {
        <a class="btn btn-primary" href="vehicles/pickups/new">Agendar recolección</a>
    }
</PageHeader>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (!CurrentUser.CanManagePickupSchedule)
{
    <div class="alert alert-warning">No tienes permiso para ver la agenda de recolección.</div>
}
else if (_items is null)
{
    <div class="page-panel"><p class="mb-0 text-muted">Cargando agenda…</p></div>
}
else
{
    <div class="page-panel mb-3">
        <h2 class="page-panel__title">Reporte por chofer</h2>
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Chofer</label>
                <select class="form-select" @bind="_reportDriverId">
                    <option value="0">Todos</option>
                    @foreach (var d in _drivers)
                    {
                        <option value="@d.Id">@d.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Desde</label>
                <InputDate class="form-control" @bind-Value="_reportFrom" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hasta</label>
                <InputDate class="form-control" @bind-Value="_reportTo" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Incluir</label>
                <select class="form-select" @bind="_reportMode">
                    <option value="both">Pendientes y recogidos</option>
                    <option value="pending">Solo pendientes</option>
                    <option value="picked">Solo recogidos</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-outline-primary w-100" @onclick="RunReportAsync" disabled="@Busy.IsBusy">
                    Generar
                </button>
            </div>
        </div>

        @if (_report is not null)
        {
            <div class="table-shell mt-3">
                @if (_report.Count == 0)
                {
                    <p class="mb-0 text-muted">Sin resultados para ese filtro.</p>
                }
                else
                {
                    <table class="table table-sm table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Chofer</th>
                                <th>VIN</th>
                                <th>Año / Modelo</th>
                                <th>Precio</th>
                                <th>Dirección</th>
                                <th>Programado</th>
                                <th>Ventana</th>
                                <th>Status</th>
                                <th>Hora recogida (ET)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _report)
                            {
                                <tr>
                                    <td>@r.DriverName</td>
                                    <td><code>@r.Vin</code></td>
                                    <td>@(r.Year?.ToString() ?? "—") @(r.Make) @(r.Model)</td>
                                    <td>@UsdMoney.FormatOrDash(r.PurchasePrice)</td>
                                    <td>@(r.PickupAddress ?? "—")</td>
                                    <td>@r.ScheduledPickupDate.ToString("yyyy-MM-dd")</td>
                                    <td>@(string.IsNullOrWhiteSpace(r.ScheduledPickupWindow) ? "—" : r.ScheduledPickupWindow)</td>
                                    <td>
                                        @if (r.Status == ScheduledPickupStatus.Pending)
                                        {
                                            <span class="badge-status badge-status--danger">Pendiente</span>
                                        }
                                        else
                                        {
                                            <span class="badge-status badge-status--ok">Recogido</span>
                                        }
                                    </td>
                                    <td>@(r.PickedUpAtEastern?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    </div>

    <div class="page-panel mb-3">
        <h2 class="page-panel__title">Enlaces de choferes</h2>
        <p class="form-hint mb-3">Copia y envía el enlace al chofer. Entra sin contraseña a su agenda del día.</p>
        @if (_drivers.Count == 0)
        {
            <p class="mb-0 text-muted">No hay usuarios con rol Chofer. Créalos en Usuarios.</p>
        }
        else
        {
            <div class="table-shell">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Chofer</th>
                            <th>Enlace</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _drivers)
                        {
                            var link = d.DriverAccessToken is Guid token
                                ? Nav.ToAbsoluteUri($"d/{token}").ToString()
                                : null;
                            <tr>
                                <td><strong>@d.DisplayName</strong></td>
                                <td>
                                    @if (link is null)
                                    {
                                        <span class="text-muted">Sin enlace — regenera en Usuarios</span>
                                    }
                                    else
                                    {
                                        <div class="form-hint mono" style="max-width:28rem;word-break:break-all">@link</div>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (link is not null)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => CopyDriverLinkAsync(link)">Copiar enlace</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="page-panel mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label">Búsqueda</label>
                <input class="form-control" placeholder="VIN, marca, modelo, chofer, dirección…"
                       @bind="_search" @bind:event="oninput" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Chofer</label>
                <select class="form-select" @bind="_driverFilter">
                    <option value="">Todos</option>
                    @foreach (var d in _drivers)
                    {
                        <option value="@d.Id.ToString()">@d.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <p class="form-hint mb-0">@Filtered.Count() en agenda · los Recogido salen a la medianoche (hora NC)</p>
            </div>
        </div>
    </div>

    @if (!Filtered.Any())
    {
        <div class="page-panel empty-state">
            <p class="empty-state__title">No hay vehículos programados</p>
            <p class="mb-3">Agenda una recolección o ajusta los filtros.</p>
            <a class="btn btn-primary" href="vehicles/pickups/new">Agendar recolección</a>
        </div>
    }
    else
    {
        <div class="page-panel table-shell">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>VIN</th>
                        <th>Año</th>
                        <th>Marca / Modelo</th>
                        <th>Precio</th>
                        <th>Dirección</th>
                        <th>Para recoger</th>
                        <th>Ventana</th>
                        <th>Chofer</th>
                        <th>Status</th>
                        <th>Hora recogida</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Filtered)
                    {
                        <tr>
                            <td><code>@s.Vin</code></td>
                            <td>@(s.Year?.ToString() ?? "—")</td>
                            <td><strong>@($"{s.Make} {s.Model}".Trim())</strong></td>
                            <td>@UsdMoney.FormatOrDash(s.PurchasePrice)</td>
                            <td>@(s.PickupAddress ?? "—")</td>
                            <td>@s.ScheduledPickupDate.ToString("yyyy-MM-dd")</td>
                            <td>@(string.IsNullOrWhiteSpace(s.ScheduledPickupWindow) ? "—" : s.ScheduledPickupWindow)</td>
                            <td>@(s.AssignedDriver?.DisplayName ?? "Sin asignar")</td>
                            <td>
                                @if (s.Status == (byte)ScheduledPickupStatus.Pending)
                                {
                                    <span class="badge-status badge-status--danger">Pendiente</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status--ok">Recogido</span>
                                }
                            </td>
                            <td>
                                @(s.PickedUpAtUtc is null
                                    ? "—"
                                    : YardTimeZone.ToEastern(s.PickedUpAtUtc.Value).ToString("HH:mm"))
                            </td>
                            <td class="text-end">
                                @if (s.Status == (byte)ScheduledPickupStatus.Pending)
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="@($"vehicles/pickups/{s.Id}/edit")">Editar</a>
                                    <button type="button"
                                            class="btn btn-sm btn-success"
                                            disabled="@Busy.IsBusy"
                                            @onclick="() => AskStaffPick(s)">Recogido</button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            disabled="@Busy.IsBusy"
                                            @onclick="() => AskDelete(s)">Eliminar</button>
                                }
                                else if (PickupScheduleService.IsPickedUpStatus(s.Status))
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            disabled="@Busy.IsBusy"
                                            @onclick="() => AskStaffRevert(s)">No recogido</button>
                                }
                                else
                                {
                                    <span class="form-hint">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (_deleteTarget is not null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">Eliminar recolección</h2>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        ¿Seguro que quieres eliminar la recolección pendiente de
                        <code>@_deleteTarget.Vin</code>?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">Cancelar</button>
                    <button type="button" class="btn btn-danger" disabled="@Busy.IsBusy" @onclick="ConfirmDeleteAsync">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_staffPickTarget is not null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">Marcar como recogido</h2>
                    <button type="button" class="btn-close" @onclick="CancelStaffPick"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        ¿Seguro que quieres marcar como recogido
                        <code>@_staffPickTarget.Vin</code>? Pasará a vehículos adquiridos.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelStaffPick">Cancelar</button>
                    <button type="button" class="btn btn-success" disabled="@Busy.IsBusy" @onclick="ConfirmStaffPickAsync">Sí, recogido</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_staffRevertTarget is not null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">Revertir recogido</h2>
                    <button type="button" class="btn-close" @onclick="CancelStaffRevert"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        ¿Seguro que quieres marcar como no recogido
                        <code>@_staffRevertTarget.Vin</code>? Se quitará de vehículos adquiridos y volverá a pendiente.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelStaffRevert">Cancelar</button>
                    <button type="button" class="btn btn-danger" disabled="@Busy.IsBusy" @onclick="ConfirmStaffRevertAsync">Sí, no recogido</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ScheduledVehiclePickup>? _items;
    private List<User> _drivers = [];
    private List<DriverReportRow>? _report;
    private string? _error;
    private string _search = string.Empty;
    private string _driverFilter = string.Empty;
    private string _reportDriverId = "0";
    private string _reportMode = "both";
    private DateTime? _reportFrom;
    private DateTime? _reportTo;
    private ScheduledVehiclePickup? _deleteTarget;
    private ScheduledVehiclePickup? _staffPickTarget;
    private ScheduledVehiclePickup? _staffRevertTarget;

    private IEnumerable<ScheduledVehiclePickup> Filtered
    {
        get
        {
            if (_items is null) return [];
            IEnumerable<ScheduledVehiclePickup> q = _items;

            if (int.TryParse(_driverFilter, out var driverId) && driverId > 0)
                q = q.Where(s => s.AssignedDriverUserId == driverId);

            var s = _search.Trim();
            if (string.IsNullOrEmpty(s)) return q;

            return q.Where(x =>
                Contains(x.Vin, s)
                || Contains(x.Make, s)
                || Contains(x.Model, s)
                || Contains(x.PickupAddress, s)
                || Contains(x.AssignedDriver?.DisplayName, s)
                || Contains(x.Year?.ToString(), s));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        if (!CurrentUser.CanManagePickupSchedule)
            return;

        try
        {
            await Busy.RunAsync(async () =>
            {
                _drivers = await Schedules.GetDriverUsersAsync();
                _items = await Schedules.GetActiveScheduleAsync();
            }, "Cargando agenda…");
        }
        catch (Exception ex)
        {
            _error = ex.Message + " — ¿Ejecutaste 015_DriverPickupSchedule.sql?";
        }
    }

    private async Task RunReportAsync()
    {
        _error = null;
        try
        {
            await Busy.RunAsync(async () =>
            {
                var includePending = _reportMode is "both" or "pending";
                var includePicked = _reportMode is "both" or "picked";
                int? driverId = int.TryParse(_reportDriverId, out var id) && id > 0 ? id : null;
                DateOnly? from = _reportFrom is null ? null : DateOnly.FromDateTime(_reportFrom.Value);
                DateOnly? to = _reportTo is null ? null : DateOnly.FromDateTime(_reportTo.Value);
                _report = await Schedules.GetDriverReportAsync(driverId, includePending, includePicked, from, to);
            }, "Generando reporte…");
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
            _error = ex.Message;
        }
    }

    private void AskDelete(ScheduledVehiclePickup s) => _deleteTarget = s;
    private void CancelDelete() => _deleteTarget = null;

    private void AskStaffPick(ScheduledVehiclePickup s) => _staffPickTarget = s;
    private void CancelStaffPick() => _staffPickTarget = null;

    private void AskStaffRevert(ScheduledVehiclePickup s) => _staffRevertTarget = s;
    private void CancelStaffRevert() => _staffRevertTarget = null;

    private async Task ConfirmStaffPickAsync()
    {
        if (_staffPickTarget is null || Busy.IsBusy) return;
        var id = _staffPickTarget.Id;
        try
        {
            await Busy.RunAsync(async () =>
            {
                await Schedules.StaffMarkPickedUpAsync(id);
                _items = await Schedules.GetActiveScheduleAsync();
            }, "Marcando recogido…");
            Toasts.Success("Marcado como recogido y añadido a adquiridos.");
            _staffPickTarget = null;
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
            _error = ex.Message;
        }
    }

    private async Task ConfirmStaffRevertAsync()
    {
        if (_staffRevertTarget is null || Busy.IsBusy) return;
        var id = _staffRevertTarget.Id;
        try
        {
            await Busy.RunAsync(async () =>
            {
                await Schedules.StaffRevertToPendingAsync(id);
                _items = await Schedules.GetActiveScheduleAsync();
            }, "Revirtiendo…");
            Toasts.Success("Revertido a pendiente.");
            _staffRevertTarget = null;
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
            _error = ex.Message;
        }
    }

    private async Task CopyDriverLinkAsync(string link)
    {
        if (string.IsNullOrWhiteSpace(link)) return;
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", link);
            Toasts.Success("Enlace del chofer copiado.");
        }
        catch
        {
            Toasts.Error("No se pudo copiar. Selecciona el enlace y cópialo manualmente.");
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null || Busy.IsBusy) return;
        var id = _deleteTarget.Id;
        _error = null;
        try
        {
            await Busy.RunAsync(async () =>
            {
                await Schedules.DeletePendingAsync(id);
                _items = await Schedules.GetActiveScheduleAsync();
            }, "Eliminando…");
            Toasts.Success("Recolección eliminada.");
            _deleteTarget = null;
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
            _error = ex.Message;
        }
    }

    private static bool Contains(string? haystack, string needle)
        => !string.IsNullOrEmpty(haystack)
           && haystack.Contains(needle, StringComparison.OrdinalIgnoreCase);
}
