@page "/vehicles"
@inject VehicleService Vehicles
@inject ICurrentUserService CurrentUser
@inject UiBusyService Busy
@inject NavigationManager Nav

<PageTitle>Vehículos</PageTitle>

<PageHeader Title="Vehículos adquiridos"
            Eyebrow="Vehículos"
            Lead="Haz clic en una fila para ver el detalle. En la miniatura abres el carrusel de fotos.">
    @if (CurrentUser.CanAcquireVehicles)
    {
        <a class="btn btn-primary" href="vehicles/acquire">Registrar adquisición</a>
    }
</PageHeader>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_items is null)
{
    <div class="page-panel"><p class="mb-0 text-muted">Cargando vehículos…</p></div>
}
else if (_items.Count == 0)
{
    <div class="page-panel empty-state">
        <p class="empty-state__title">Aún no hay vehículos</p>
        <p class="mb-3">Registra la primera adquisición con VIN y fuente de compra.</p>
        @if (CurrentUser.CanAcquireVehicles)
        {
            <a class="btn btn-primary" href="vehicles/acquire">Registrar adquisición</a>
        }
    </div>
}
else
{
    <div class="page-panel mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label" for="veh-search">Búsqueda rápida</label>
                <input id="veh-search"
                       class="form-control"
                       placeholder="VIN, recib, marca, modelo, año, fuente…"
                       @bind="_search"
                       @bind:event="oninput" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Ubicación</label>
                <select class="form-select" @bind="_locationFilter">
                    <option value="">Todas</option>
                    <option value="located">Con ubicación</option>
                    <option value="unlocated">Sin ubicar</option>
                </select>
            </div>
            <div class="col-md-3">
                <p class="form-hint mb-0">@Filtered.Count() de @_items.Count vehículos</p>
            </div>
        </div>
    </div>

    @if (!Filtered.Any())
    {
        <div class="page-panel empty-state">
            <p class="empty-state__title">Sin resultados</p>
            <p class="mb-0">Prueba otro VIN, número de recibo, marca o ubicación.</p>
        </div>
    }
    else
    {
        <div class="page-panel table-shell">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th></th>
                        <th>VIN</th>
                        <th>Recibo</th>
                        <th>Año</th>
                        <th>Marca / Modelo</th>
                        <th>Millas</th>
                        <th>Precio</th>
                        <th>Fuente</th>
                        <th>Adquirido</th>
                        <th>Ubicación</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Filtered)
                    {
                        var vehicleId = v.Id;
                        var images = MediaPaths.ToUrls(VehicleService.GetImagePaths(v));
                        <tr class="row-clickable" @onclick="@(() => GoToDetail(vehicleId))">
                            <td style="width:3.75rem" @onclick:stopPropagation="true">
                                @if (images.Count > 0)
                                {
                                    <button type="button"
                                            class="thumb-btn"
                                            title="@(images.Count == 1 ? "Ver foto" : $"Carrusel · {images.Count} fotos")"
                                            @onclick="@(() => OpenViewer(images))">
                                        <img class="thumb-img" src="@images[0]" alt="" />
                                        @if (images.Count > 1)
                                        {
                                            <span class="thumb-btn__badge">@images.Count</span>
                                        }
                                    </button>
                                }
                            </td>
                            <td><code>@v.Vin</code></td>
                            <td>@(v.InvoiceNumber is null ? "—" : $"#{v.InvoiceNumber}")</td>
                            <td>@(v.Year?.ToString() ?? "—")</td>
                            <td>
                                <strong>@(string.IsNullOrWhiteSpace($"{v.Make} {v.Model}".Trim()) ? "—" : $"{v.Make} {v.Model}".Trim())</strong>
                            </td>
                            <td>@(v.Mileage?.ToString("N0") ?? "—")</td>
                            <td>@UsdMoney.FormatOrDash(v.PurchasePrice)</td>
                            <td>@v.VehicleSource.Name</td>
                            <td>@v.AcquiredAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (v.Pallet is null)
                                {
                                    <span class="badge-status badge-status--warn">Sin ubicar</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status--ok">@YardLayoutService.FormatPalletLabel(v.Pallet)</span>
                                }
                            </td>
                            <td class="text-end" @onclick:stopPropagation="true">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"vehicles/{vehicleId}")">Ver</a>
                                @if (CurrentUser.CanEditInventory || CurrentUser.CanManageZones)
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="@($"vehicles/{vehicleId}/assign")">
                                        @(v.Pallet is null ? "Ubicar" : "Mover")
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<ImageViewer @ref="_viewer" />

@code {
    private List<Vehicle>? _items;
    private string? _error;
    private string _search = string.Empty;
    private string _locationFilter = string.Empty;
    private ImageViewer? _viewer;

    private IEnumerable<Vehicle> Filtered
    {
        get
        {
            if (_items is null) return [];
            IEnumerable<Vehicle> q = _items;

            if (_locationFilter == "located")
                q = q.Where(v => v.PalletId is not null);
            else if (_locationFilter == "unlocated")
                q = q.Where(v => v.PalletId is null);

            var s = _search.Trim();
            if (string.IsNullOrEmpty(s)) return q;

            return q.Where(v =>
                Contains(v.Vin, s)
                || Contains(v.Make, s)
                || Contains(v.Model, s)
                || Contains(v.Year?.ToString(), s)
                || Contains(v.VehicleSource?.Name, s)
                || Contains(v.Pallet is null ? "Sin ubicar" : YardLayoutService.FormatPalletLabel(v.Pallet), s)
                || MatchesInvoiceNumber(v.InvoiceNumber, s));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Busy.RunAsync(async () =>
            {
                _items = await Vehicles.GetAllAsync();
            }, "Cargando vehículos…");
        }
        catch (Exception ex)
        {
            _error = ex.Message + " — ¿Ejecutaste los scripts SQL (incl. 007_VehicleImages)?";
        }
    }

    private void GoToDetail(int id) => Nav.NavigateTo($"vehicles/{id}");

    private async Task OpenViewer(IReadOnlyList<string> images)
    {
        if (_viewer is null || images.Count == 0) return;
        await _viewer.OpenAsync(images);
    }

    private static bool Contains(string? haystack, string needle)
        => !string.IsNullOrEmpty(haystack)
           && haystack.Contains(needle, StringComparison.OrdinalIgnoreCase);

    /// <summary>Matches 1000, #1000, 001000, NO. 001000, etc.</summary>
    private static bool MatchesInvoiceNumber(int? invoiceNumber, string needle)
    {
        if (invoiceNumber is null or <= 0)
            return false;

        var n = invoiceNumber.Value;
        var raw = needle.Trim();
        if (raw.Length == 0)
            return false;

        if (Contains(n.ToString(), raw)
            || Contains($"#{n}", raw)
            || Contains($"{n:000000}", raw)
            || Contains($"NO. {n:000000}", raw))
        {
            return true;
        }

        var digits = new string(raw.Where(char.IsDigit).ToArray());
        if (digits.Length == 0)
            return false;

        if (int.TryParse(digits, out var parsed) && parsed == n)
            return true;

        // Partial digit match, e.g. "100" finds 1000 / 1100
        return n.ToString().Contains(digits, StringComparison.Ordinal);
    }
}
