@page "/vehicles"
@inject VehicleService Vehicles
@inject ICurrentUserService CurrentUser
@inject UiBusyService Busy
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Vehículos</PageTitle>

<PageHeader Title="Vehículos adquiridos"
            Eyebrow="Vehículos"
            Lead="Haz clic en una fila para ver el detalle. En la miniatura abres el carrusel de fotos.">
    @if (CurrentUser.CanAcquireVehicles)
    {
        <a class="btn btn-primary" href="vehicles/acquire">Registrar adquisición</a>
    }
</PageHeader>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_items is null)
{
    <div class="page-panel"><p class="mb-0 text-muted">Cargando vehículos…</p></div>
}
else if (_totalCount == 0 && string.IsNullOrWhiteSpace(_search) && string.IsNullOrEmpty(_locationFilter) && string.IsNullOrEmpty(_driverFilterId))
{
    <div class="page-panel empty-state">
        <p class="empty-state__title">Aún no hay vehículos</p>
        <p class="mb-3">Registra la primera adquisición con VIN y fuente de compra.</p>
        @if (CurrentUser.CanAcquireVehicles)
        {
            <a class="btn btn-primary" href="vehicles/acquire">Registrar adquisición</a>
        }
    </div>
}
else
{
    <div class="page-panel mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label" for="veh-search">Búsqueda rápida</label>
                <input id="veh-search"
                       class="form-control"
                       placeholder="VIN, recib, marca, modelo, año, fuente…"
                       @bind="_search"
                       @bind:event="oninput"
                       @onkeydown="OnSearchKeyDown" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Ubicación</label>
                <select class="form-select" @bind="_locationFilter" @bind:after="ReloadFromFiltersAsync">
                    <option value="">Todas</option>
                    <option value="located">Con ubicación</option>
                    <option value="unlocated">Sin ubicar</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Recogido por</label>
                <select class="form-select" @bind="_driverFilterId" @bind:after="ReloadFromFiltersAsync">
                    <option value="">Todos</option>
                    @foreach (var d in _drivers)
                    {
                        <option value="@d.Id">@d.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-outline-primary w-100" disabled="@Busy.IsBusy" @onclick="SearchClickAsync">
                    Buscar
                </button>
            </div>
            <div class="col-md-12">
                <p class="form-hint mb-0">
                    @if (_totalCount == 0)
                    {
                        <text>Sin resultados</text>
                    }
                    else
                    {
                        <text>Mostrando @_fromIndex–@_toIndex de @_totalCount · página @_page de @_pageCount</text>
                    }
                </p>
            </div>
        </div>
    </div>

    @if (_items.Count == 0)
    {
        <div class="page-panel empty-state">
            <p class="empty-state__title">Sin resultados</p>
            <p class="mb-0">Prueba otro VIN, número de recibo, marca o ubicación.</p>
        </div>
    }
    else
    {
        <div class="page-panel table-shell">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th></th>
                        <th>VIN</th>
                        <th>Recibo</th>
                        <th>Año</th>
                        <th>Marca / Modelo</th>
                        <th>Millas</th>
                        <th>Precio</th>
                        <th>Fuente</th>
                        <th>Recogido por</th>
                        <th>Adquirido</th>
                        <th>Ubicación</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in _items)
                    {
                        var vehicleId = v.Id;
                        var images = MediaPaths.ToUrls(VehicleService.GetImagePaths(v));
                        <tr class="row-clickable" @onclick="@(() => GoToDetail(vehicleId))">
                            <td style="width:3.75rem" @onclick:stopPropagation="true">
                                @if (images.Count > 0)
                                {
                                    <button type="button"
                                            class="thumb-btn"
                                            title="@(images.Count == 1 ? "Ver foto" : $"Carrusel · {images.Count} fotos")"
                                            @onclick="@(() => OpenViewer(images))">
                                        <img class="thumb-img" src="@images[0]" alt="" loading="lazy" />
                                        @if (images.Count > 1)
                                        {
                                            <span class="thumb-btn__badge">@images.Count</span>
                                        }
                                    </button>
                                }
                            </td>
                            <td><code>@v.Vin</code></td>
                            <td>@(v.InvoiceNumber is null ? "—" : $"#{v.InvoiceNumber}")</td>
                            <td>@(v.Year?.ToString() ?? "—")</td>
                            <td>
                                <strong>@(string.IsNullOrWhiteSpace($"{v.Make} {v.Model}".Trim()) ? "—" : $"{v.Make} {v.Model}".Trim())</strong>
                            </td>
                            <td>@(v.Mileage?.ToString("N0") ?? "—")</td>
                            <td>@UsdMoney.FormatOrDash(v.PurchasePrice)</td>
                            <td>@v.VehicleSource.Name</td>
                            <td>@(string.IsNullOrWhiteSpace(v.PickupDriverUser?.DisplayName)
                                ? (string.IsNullOrWhiteSpace(v.PickupDriver) ? "—" : v.PickupDriver)
                                : v.PickupDriverUser!.DisplayName)</td>
                            <td>@v.AcquiredAt.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (v.Pallet is null)
                                {
                                    <span class="badge-status badge-status--warn">Sin ubicar</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status--ok">@YardLayoutService.FormatPalletLabel(v.Pallet)</span>
                                }
                            </td>
                            <td class="text-end" @onclick:stopPropagation="true">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"vehicles/{vehicleId}")">Ver</a>
                                @if (CurrentUser.CanEditInventory || CurrentUser.CanManageZones)
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="@($"vehicles/{vehicleId}/assign")">
                                        @(v.Pallet is null ? "Ubicar" : "Mover")
                                    </a>
                                }
                                @if (CurrentUser.CanManageUsers)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Eliminar vehículo"
                                            @onclick="() => AskDelete(v)">Eliminar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (_pageCount > 1)
            {
                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mt-3">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@(_page <= 1 || Busy.IsBusy)"
                            @onclick="PreviousPageAsync">Anterior</button>
                    <span class="form-hint mb-0">Página @_page / @_pageCount</span>
                    <button type="button"
                            class="btn btn-outline-secondary"
                            disabled="@(_page >= _pageCount || Busy.IsBusy)"
                            @onclick="NextPageAsync">Siguiente</button>
                </div>
            }
        </div>
    }
}

<ImageViewer @ref="_viewer" />

@if (_deleteTarget is not null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">Eliminar vehículo</h2>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>
                        ¿Seguro que quieres eliminar <code>@_deleteTarget.Vin</code>
                        @if (!string.IsNullOrWhiteSpace($"{_deleteTarget.Make} {_deleteTarget.Model}".Trim()))
                        {
                            <text> (@_deleteTarget.Year @_deleteTarget.Make @_deleteTarget.Model)</text>
                        }
                        de los vehículos adquiridos?
                    </p>
                    <p class="form-hint mb-0">
                        Se borran sus fotos, movimientos e historial de precio. Si vino de la agenda de recolección,
                        esa recolección vuelve a quedar pendiente. Esta acción no se puede deshacer.
                    </p>
                    @if (_deleteTarget.Pallet is not null || _deleteTarget.InvoiceNumber is not null)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            @if (_deleteTarget.Pallet is not null)
                            {
                                <div>Está ubicado en @YardLayoutService.FormatPalletLabel(_deleteTarget.Pallet).</div>
                            }
                            @if (_deleteTarget.InvoiceNumber is not null)
                            {
                                <div>Ya tiene recibo #@_deleteTarget.InvoiceNumber.</div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelDelete">Cancelar</button>
                    <button type="button" class="btn btn-danger" disabled="@Busy.IsBusy" @onclick="ConfirmDeleteAsync">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const int PageSize = 25;

    private List<Vehicle>? _items;
    private List<User> _drivers = [];
    private int _totalCount;
    private int _page = 1;
    private string? _error;
    private string _search = string.Empty;
    private string _locationFilter = string.Empty;
    private string _driverFilterId = string.Empty;
    private ImageViewer? _viewer;
    private Vehicle? _deleteTarget;

    private int _pageCount => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));
    private int _fromIndex => _totalCount == 0 ? 0 : ((_page - 1) * PageSize) + 1;
    private int _toIndex => Math.Min(_page * PageSize, _totalCount);

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.CanViewVehicles)
        {
            _error = "No tiene permiso para ver vehículos.";
            return;
        }

        try
        {
            await Busy.RunAsync(async () =>
            {
                if (CurrentUser.CanEditVehicles)
                {
                    try { await Vehicles.BackfillPickupDriverLinksAsync(); }
                    catch { /* column may not exist yet */ }
                }

                _drivers = await Vehicles.GetActiveDriversAsync();
                await LoadPageAsync();
            }, "Cargando vehículos…");
        }
        catch (Exception ex)
        {
            _error = ex.Message + " — ¿Ejecutaste los scripts SQL (incl. 017_VehiclePickupDriverUser)?";
        }
    }

    private async Task LoadPageAsync()
    {
        int? driverId = int.TryParse(_driverFilterId, out var id) && id > 0 ? id : null;
        var (items, total) = await Vehicles.GetPageAsync(
            _search,
            _locationFilter,
            driverId,
            _page,
            PageSize);
        _items = items;
        _totalCount = total;
        if (_page > _pageCount)
        {
            _page = _pageCount;
            if (_totalCount > 0)
            {
                (items, total) = await Vehicles.GetPageAsync(
                    _search,
                    _locationFilter,
                    driverId,
                    _page,
                    PageSize);
                _items = items;
                _totalCount = total;
            }
        }
    }

    private async Task SearchClickAsync()
    {
        _page = 1;
        await ReloadAsync();
    }

    private async Task ReloadFromFiltersAsync()
    {
        _page = 1;
        await ReloadAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (_page <= 1) return;
        _page--;
        await ReloadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_page >= _pageCount) return;
        _page++;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _error = null;
        try
        {
            await Busy.RunAsync(LoadPageAsync, "Cargando vehículos…");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchClickAsync();
    }

    private void GoToDetail(int id) => Nav.NavigateTo($"vehicles/{id}");

    private void AskDelete(Vehicle v) => _deleteTarget = v;
    private void CancelDelete() => _deleteTarget = null;

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null || Busy.IsBusy) return;
        var id = _deleteTarget.Id;
        var vin = _deleteTarget.Vin;
        _error = null;
        try
        {
            await Busy.RunAsync(async () =>
            {
                await Vehicles.DeleteAsync(id);
                await LoadPageAsync();
            }, "Eliminando…");
            Toasts.Success($"Vehículo {vin} eliminado.");
            _deleteTarget = null;
        }
        catch (Exception ex)
        {
            Toasts.Error(ex.Message);
            _error = ex.Message;
        }
    }

    private async Task OpenViewer(IReadOnlyList<string> images)
    {
        if (_viewer is null || images.Count == 0) return;
        await _viewer.OpenAsync(images);
    }
}
