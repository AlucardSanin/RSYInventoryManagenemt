@page "/vehicles"
@rendermode InteractiveServer
@using RSYInventory.Data.Entities
@using RSYInventory.Data.Services
@inject VehicleService Vehicles

<PageTitle>Vehículos</PageTitle>

<h1>Vehículos adquiridos</h1>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

<div class="mb-3 d-flex gap-2">
    <a class="btn btn-primary" href="vehicles/acquire">Registrar adquisición</a>
</div>

@if (_items is null)
{
    <p>Cargando…</p>
}
else if (_items.Count == 0)
{
    <p>Aún no hay vehículos registrados.</p>
}
else
{
    <table class="table table-striped table-sm align-middle">
        <thead>
            <tr>
                <th>VIN</th>
                <th>Año</th>
                <th>Marca / Modelo</th>
                <th>Fuente</th>
                <th>Adquirido</th>
                <th>Ubicación</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in _items)
            {
                <tr>
                    <td><code>@v.Vin</code></td>
                    <td>@(v.Year?.ToString() ?? "—")</td>
                    <td>@v.Make @v.Model</td>
                    <td>@v.VehicleSource.Name</td>
                    <td>@v.AcquiredAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (v.Pallet is null)
                        {
                            <span class="text-warning">Sin ubicar</span>
                        }
                        else
                        {
                            @YardLayoutService.FormatPalletLabel(v.Pallet)
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="@($"vehicles/{v.Id}/assign")">Asignar ubicación</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Vehicle>? _items;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = await Vehicles.GetAllAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message + " — ¿Ejecutaste los scripts SQL?";
        }
    }
}
