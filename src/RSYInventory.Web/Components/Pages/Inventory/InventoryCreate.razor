@page "/inventory/new"
@implements IDisposable
@inject InventoryService Inventory
@inject YardLayoutService Layout
@inject VinLookupService VinLookup
@inject MediaStorageService Media
@inject UiBusyService Busy
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Añadir pieza</PageTitle>

<PageHeader Title="Añadir motor o transmisión"
            Eyebrow="Inventario"
            Lead="Elige el tipo de pieza y carga los datos a mano o desde un VIN. En móvil el formulario va por pasos.">
    <a class="btn btn-outline-secondary" href="inventory">Volver al inventario</a>
</PageHeader>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}
@if (!string.IsNullOrEmpty(_info))
{
    <div class="alert alert-info">@_info</div>
}

<div class="page-panel">
    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <div class="form-stepper" data-step="@_mobileStep">
            <div class="form-stepper__progress" aria-hidden="true">
                @for (var i = 1; i <= MobileStepCount; i++)
                {
                    <span class="form-stepper__dot @(i == _mobileStep ? "is-active" : null) @(i < _mobileStep ? "is-done" : null)"></span>
                }
            </div>
            <p class="form-stepper__label">Paso @_mobileStep de @MobileStepCount · @MobileStepTitle</p>

            @* Step 1: tipo *@
            <div class="form-step @(_mobileStep == 1 ? "is-active" : null)">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label d-block mb-2">Tipo de pieza *</label>
                        <div class="choice-cards choice-cards--compact">
                            <button type="button"
                                    class="choice-card text-start @(_model.ItemType == InventoryItemType.Engine ? "is-selected" : null)"
                                    @onclick="@(() => SetItemType(InventoryItemType.Engine))">
                                <strong>Motor</strong>
                                <span>Cilindrada y datos del motor.</span>
                            </button>
                            <button type="button"
                                    class="choice-card text-start @(_model.ItemType == InventoryItemType.Transmission ? "is-selected" : null)"
                                    @onclick="@(() => SetItemType(InventoryItemType.Transmission))">
                                <strong>Transmisión</strong>
                                <span>Tipo de caja y tracción.</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @* Step 2: método + VIN *@
            <div class="form-step @(_mobileStep == 2 ? "is-active" : null)">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label d-block mb-2">Cómo quieres cargar los datos</label>
                        <div class="choice-cards">
                            <button type="button"
                                    class="choice-card text-start @(_entryMode == EntryMode.Manual ? "is-selected" : null)"
                                    @onclick="@(() => _entryMode = EntryMode.Manual)">
                                <strong>Manual</strong>
                                <span>Escribes año, marca, modelo y el resto a mano.</span>
                            </button>
                            <button type="button"
                                    class="choice-card text-start @(_entryMode == EntryMode.VinDecode ? "is-selected" : null)"
                                    @onclick="@(() => _entryMode = EntryMode.VinDecode)">
                                <strong>Decodificar VIN</strong>
                                <span>Usa el VIN del vehículo donante para sugerir año, marca y modelo.</span>
                            </button>
                        </div>
                    </div>

                    @if (_entryMode == EntryMode.VinDecode)
                    {
                        <div class="col-md-8">
                            <label class="form-label">VIN del vehículo donante</label>
                            <input class="form-control mono" maxlength="17" @bind="_model.SourceVin" @bind:event="oninput" placeholder="17 caracteres" />
                        </div>
                        <div class="col-md-4 d-flex flex-column justify-content-end">
                            <button type="button" class="btn btn-outline-primary w-100" @onclick="DecodeVinAsync" disabled="@Busy.IsBusy">Decodificar VIN</button>
                            @if (!string.IsNullOrEmpty(_vinHint))
                            {
                                <div class="vin-hint">@_vinHint</div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6">
                            <label class="form-label">VIN donante (opcional)</label>
                            <input class="form-control mono" maxlength="17" @bind="_model.SourceVin" placeholder="Si lo tienes, puedes guardarlo" />
                        </div>
                    }
                </div>
            </div>

            @* Step 3: año → marca → modelo *@
            <div class="form-step @(_mobileStep == 3 ? "is-active" : null)">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="year-combo">Año</label>
                        <SearchableCombo InputId="year-combo"
                                         Value="@YearValue"
                                         ValueChanged="OnYearChangedAsync"
                                         Options="_yearOptions"
                                         Placeholder="Escribe 201… o elige"
                                         EmptyHint="Elige un año de la lista"
                                         AllowCustom="false"
                                         MaxSuggestions="@VehicleYearCatalog.DropdownVisibleCount" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="brand-combo">Marca</label>
                        <SearchableCombo InputId="brand-combo"
                                         Value="@_model.Brand"
                                         ValueChanged="OnBrandChangedAsync"
                                         Options="_brandOptions"
                                         Placeholder="@(_model.Year is null ? "Primero elige un año" : "Escribe M… o elige")"
                                         EmptyHint="@(_model.Year is null ? "Primero elige un año" : "Escribe para filtrar marcas")"
                                         Disabled="@(_model.Year is null)"
                                         AllowCustom="true" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="model-combo">Modelo</label>
                        <SearchableCombo InputId="model-combo"
                                         @bind-Value="_model.Model"
                                         Options="_modelOptions"
                                         Placeholder="@ModelPlaceholder"
                                         EmptyHint="@ModelEmptyHint"
                                         Disabled="@string.IsNullOrWhiteSpace(_model.Brand)"
                                         AllowCustom="true"
                                         MaxSuggestions="50" />
                    </div>
                </div>
            </div>

            @* Step 4: detalles específicos *@
            <div class="form-step @(_mobileStep == 4 ? "is-active" : null)">
                <div class="row g-3">
                    @if (_model.ItemType == InventoryItemType.Engine)
                    {
                        <div class="col-md-4">
                            <label class="form-label" for="disp-combo">Cilindrada (litros) *</label>
                            <SearchableCombo InputId="disp-combo"
                                             Value="@DisplacementValue"
                                             ValueChanged="OnDisplacementChangedAsync"
                                             Options="_displacementOptions"
                                             Placeholder="Ej. 2.5 — escribe o elige"
                                             AllowCustom="true" />
                            <div class="form-text">Ejemplos: 1.8, 2.0, 3.5, 5.7</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Nº de parte <span class="form-hint">(opcional)</span></label>
                            <InputText class="form-control" @bind-Value="_model.PartNumber" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Descripción corta <span class="form-hint">(opcional)</span></label>
                            <InputText class="form-control" @bind-Value="_model.Description" placeholder="Ej. motor completo" />
                        </div>
                    }
                    else
                    {
                        <div class="col-md-4">
                            <label class="form-label" for="trans-combo">Tipo de transmisión *</label>
                            <SearchableCombo InputId="trans-combo"
                                             Value="@TransmissionValue"
                                             ValueChanged="OnTransmissionChangedAsync"
                                             Options="_transmissionOptions"
                                             Placeholder="Automática o manual"
                                             AllowCustom="false" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="drive-combo">Tracción *</label>
                            <SearchableCombo InputId="drive-combo"
                                             Value="@DriveValue"
                                             ValueChanged="OnDriveChangedAsync"
                                             Options="_driveOptions"
                                             Placeholder="FWD, RWD, AWD…"
                                             AllowCustom="false" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Nº de parte <span class="form-hint">(opcional)</span></label>
                            <InputText class="form-control" @bind-Value="_model.PartNumber" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Descripción corta <span class="form-hint">(opcional)</span></label>
                            <InputText class="form-control" @bind-Value="_model.Description" placeholder="Ej. caja automática 6 velocidades" />
                        </div>
                    }
                </div>
            </div>

            @* Step 5: ubicación + extras *@
            <div class="form-step @(_mobileStep == 5 ? "is-active" : null)">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="zone-combo">Zona *</label>
                        <SearchableCombo InputId="zone-combo"
                                         Value="@ZoneValue"
                                         ValueChanged="OnZoneChangedAsync"
                                         Options="_zoneOptions"
                                         Placeholder="Elige una zona de partes…"
                                         AllowCustom="false" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="row-combo">Fila *</label>
                        <SearchableCombo InputId="row-combo"
                                         Value="@RowValue"
                                         ValueChanged="OnRowChangedAsync"
                                         Options="_rowOptions"
                                         Placeholder="@(_selectedZoneId <= 0 ? "Primero elige una zona" : "Elige una fila…")"
                                         EmptyHint="@(_selectedZoneId <= 0 ? "Primero elige una zona" : "Sin filas en esta zona")"
                                         Disabled="@(_selectedZoneId <= 0)"
                                         AllowCustom="false" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="pallet-combo">Paleta *</label>
                        <SearchableCombo InputId="pallet-combo"
                                         Value="@PalletValue"
                                         ValueChanged="OnPalletChangedAsync"
                                         Options="_palletOptions"
                                         Placeholder="@(_selectedRowId <= 0 ? "Primero elige una fila" : "Elige una paleta…")"
                                         EmptyHint="@(_selectedRowId <= 0 ? "Primero elige una fila" : "Sin paletas en esta fila")"
                                         Disabled="@(_selectedRowId <= 0)"
                                         AllowCustom="false" />
                    </div>
                    <div class="col-12">
                        <div class="form-text">Solo zonas de <strong>partes</strong>. Máx. 1 motor y 2 transmisiones por paleta.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Foto <span class="form-hint">(opcional)</span></label>
                        <InputFile class="form-control" OnChange="OnImageSelected" accept=".jpg,.jpeg,.png,.webp,image/*" />
                        <div class="image-upload-hint">JPG/PNG/WEBP. Se guarda en disco (compatible Windows y Linux).</div>
                        @if (!string.IsNullOrEmpty(_imageName))
                        {
                            <div class="form-hint mt-1">Seleccionado: @_imageName</div>
                        }
                    </div>
                    <div class="col-12">
                        <label class="form-label">Observaciones <span class="form-hint">(opcional)</span></label>
                        <InputTextArea class="form-control" @bind-Value="_model.Notes" rows="3" />
                    </div>
                </div>
            </div>

            <div class="form-stepper__nav">
                @if (_mobileStep > 1)
                {
                    <button type="button" class="btn btn-outline-secondary" @onclick="PreviousStep" disabled="@Busy.IsBusy">Atrás</button>
                }
                @if (_mobileStep < MobileStepCount)
                {
                    <button type="button" class="btn btn-primary" @onclick="NextStep" disabled="@Busy.IsBusy">Siguiente</button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary" disabled="@(_saving || Busy.IsBusy)">
                        @(_saving ? "Guardando…" : "Guardar pieza")
                    </button>
                }
            </div>
        </div>

        <div class="form-actions form-actions--desktop">
            <button type="submit" class="btn btn-primary" disabled="@(_saving || Busy.IsBusy)">
                @(_saving ? "Guardando…" : "Guardar pieza")
            </button>
            <a class="btn btn-link" href="inventory">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    private const int MobileStepCount = 5;

    private static readonly IReadOnlyList<ComboOption> _transmissionOptions =
    [
        new(((int)TransmissionType.Automatic).ToString(), "Automática"),
        new(((int)TransmissionType.Manual).ToString(), "Manual")
    ];

    private static readonly IReadOnlyList<ComboOption> _driveOptions =
    [
        new(((int)VehicleDriveType.Fwd).ToString(), "FWD"),
        new(((int)VehicleDriveType.Rwd).ToString(), "RWD"),
        new(((int)VehicleDriveType.Awd).ToString(), "AWD"),
        new(((int)VehicleDriveType.FourByFour).ToString(), "4x4"),
        new(((int)VehicleDriveType.FourByTwo).ToString(), "4x2")
    ];

    private static readonly IReadOnlyList<ComboOption> _displacementOptions =
        new[] { "1.5", "1.6", "1.8", "2.0", "2.4", "2.5", "3.0", "3.5", "3.6", "4.0", "4.6", "5.0", "5.3", "5.7", "6.0", "6.2" }
            .Select(v => new ComboOption(v, $"{v} L", v))
            .ToList();

    private static readonly IReadOnlyList<ComboOption> _yearOptions =
        VehicleYearCatalog.AllYears.Select(y => new ComboOption(y, y)).ToList();

    private readonly CreateModel _model = new();
    private List<Zone> _zones = [];
    private List<ComboOption> _zoneOptions = [];
    private List<ComboOption> _rowOptions = [];
    private List<ComboOption> _palletOptions = [];
    private List<ComboOption> _brandOptions = [];
    private List<ComboOption> _modelOptions = [];
    private int _selectedZoneId;
    private int _selectedRowId;
    private CancellationTokenSource? _modelLoadCts;
    private bool _loadingModels;
    private string? _error;
    private string? _info;
    private string? _vinHint;
    private bool _saving;
    private EntryMode _entryMode = EntryMode.Manual;
    private int _mobileStep = 1;
    private IBrowserFile? _imageFile;
    private string? _imageName;

    private string? YearValue => _model.Year?.ToString();
    private string? ZoneValue => _selectedZoneId <= 0 ? null : _selectedZoneId.ToString();
    private string? RowValue => _selectedRowId <= 0 ? null : _selectedRowId.ToString();
    private string? PalletValue => _model.PalletId <= 0 ? null : _model.PalletId.ToString();
    private string? TransmissionValue => _model.TransmissionType is null ? null : ((int)_model.TransmissionType.Value).ToString();
    private string? DriveValue => _model.DriveType is null ? null : ((int)_model.DriveType.Value).ToString();
    private string? DisplacementValue => _model.DisplacementLiters?.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private string MobileStepTitle => _mobileStep switch
    {
        1 => "Tipo de pieza",
        2 => "Cómo cargar datos",
        3 => "Año, marca y modelo",
        4 => _model.ItemType == InventoryItemType.Engine ? "Datos del motor" : "Datos de la transmisión",
        _ => "Ubicación y extras"
    };

    private string ModelPlaceholder =>
        _model.Year is null ? "Primero elige un año"
        : string.IsNullOrWhiteSpace(_model.Brand) ? "Primero elige una marca"
        : _loadingModels ? "Cargando modelos…"
        : "Escribe Foc… o elige";

    private string ModelEmptyHint =>
        _model.Year is null ? "Primero elige un año"
        : string.IsNullOrWhiteSpace(_model.Brand) ? "Primero elige una marca"
        : "Escribe para filtrar modelos";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Busy.RunAsync(async () =>
            {
                _zones = await Layout.GetZonesAsync(ZonePurpose.Parts);
                _zoneOptions = _zones
                    .Select(z => new ComboOption(z.Id.ToString(), z.Name, z.Name))
                    .ToList();

                var brands = await Inventory.GetDistinctBrandsAsync();
                _brandOptions = brands.Select(b => new ComboOption(b, b)).ToList();
                if (!string.IsNullOrWhiteSpace(_model.Brand) && _model.Year is not null)
                    await ReloadModelOptionsAsync();
            }, "Cargando formulario…");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    public void Dispose() => _modelLoadCts?.Cancel();

    private void PreviousStep()
    {
        _error = null;
        if (_mobileStep > 1)
            _mobileStep--;
    }

    private void NextStep()
    {
        _error = null;
        if (!ValidateCurrentStep(out var message))
        {
            _error = message;
            return;
        }

        if (_mobileStep < MobileStepCount)
            _mobileStep++;
    }

    private bool ValidateCurrentStep(out string? message)
    {
        message = null;
        switch (_mobileStep)
        {
            case 2 when _entryMode == EntryMode.VinDecode
                        && string.IsNullOrWhiteSpace(_model.SourceVin):
                message = "Ingresa el VIN del donante o cambia a carga manual.";
                return false;
            case 4 when _model.ItemType == InventoryItemType.Engine
                        && _model.DisplacementLiters is null:
                message = "Indica la cilindrada del motor.";
                return false;
            case 4 when _model.ItemType == InventoryItemType.Transmission
                        && (_model.TransmissionType is null || _model.DriveType is null):
                message = "Indica el tipo de transmisión y la tracción.";
                return false;
            case 5 when _model.PalletId <= 0:
                message = "Selecciona zona, fila y paleta.";
                return false;
            default:
                return true;
        }
    }

    private void SetItemType(InventoryItemType type)
    {
        if (_model.ItemType == type) return;
        _model.ItemType = type;
        _info = null;
        if (type == InventoryItemType.Engine)
        {
            _model.TransmissionType = null;
            _model.DriveType = null;
        }
        else
        {
            _model.DisplacementLiters = null;
        }
    }

    private Task OnZoneChangedAsync(string? value)
    {
        var next = int.TryParse(value, out var id) ? id : 0;
        if (next == _selectedZoneId) return Task.CompletedTask;

        _selectedZoneId = next;
        _selectedRowId = 0;
        _model.PalletId = 0;
        RebuildRowOptions();
        _palletOptions = [];
        return Task.CompletedTask;
    }

    private Task OnRowChangedAsync(string? value)
    {
        var next = int.TryParse(value, out var id) ? id : 0;
        if (next == _selectedRowId) return Task.CompletedTask;

        _selectedRowId = next;
        _model.PalletId = 0;
        RebuildPalletOptions();
        return Task.CompletedTask;
    }

    private Task OnPalletChangedAsync(string? value)
    {
        _model.PalletId = int.TryParse(value, out var id) ? id : 0;
        return Task.CompletedTask;
    }

    private void RebuildRowOptions()
    {
        var zone = _zones.FirstOrDefault(z => z.Id == _selectedZoneId);
        _rowOptions = (zone?.Rows ?? [])
            .Where(r => r.IsActive)
            .OrderBy(r => r.RowNumber)
            .Select(r =>
            {
                var label = string.IsNullOrWhiteSpace(r.Label)
                    ? $"Fila {r.RowNumber}"
                    : $"Fila {r.RowNumber} ({r.Label})";
                return new ComboOption(r.Id.ToString(), label, label);
            })
            .ToList();
    }

    private void RebuildPalletOptions()
    {
        var zone = _zones.FirstOrDefault(z => z.Id == _selectedZoneId);
        var row = zone?.Rows.FirstOrDefault(r => r.Id == _selectedRowId);
        _palletOptions = (row?.Pallets ?? [])
            .Where(p => p.IsActive)
            .OrderBy(p => p.PalletNumber)
            .Select(p =>
            {
                var label = string.IsNullOrWhiteSpace(p.Label)
                    ? $"Paleta {p.PalletNumber}"
                    : $"Paleta {p.PalletNumber} ({p.Label})";
                return new ComboOption(p.Id.ToString(), label, label);
            })
            .ToList();
    }

    private void OnImageSelected(InputFileChangeEventArgs e)
    {
        _imageFile = e.File;
        _imageName = e.File?.Name;
    }

    private async Task OnYearChangedAsync(string? value)
    {
        var previous = _model.Year;
        _model.Year = int.TryParse(value, out var y) ? y : null;

        if (_model.Year != previous)
        {
            _model.Brand = null;
            _model.Model = null;
            _modelOptions = [];
        }

        await Task.CompletedTask;
    }

    private async Task OnBrandChangedAsync(string? value)
    {
        var previous = _model.Brand;
        _model.Brand = value;
        if (!string.Equals(previous, value, StringComparison.OrdinalIgnoreCase))
            _model.Model = null;
        await ScheduleModelReloadAsync();
    }

    private Task OnTransmissionChangedAsync(string? value)
    {
        _model.TransmissionType = int.TryParse(value, out var n) ? (TransmissionType)n : null;
        return Task.CompletedTask;
    }

    private Task OnDriveChangedAsync(string? value)
    {
        _model.DriveType = int.TryParse(value, out var n) ? (VehicleDriveType)n : null;
        return Task.CompletedTask;
    }

    private Task OnDisplacementChangedAsync(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _model.DisplacementLiters = null;
            return Task.CompletedTask;
        }

        _model.DisplacementLiters = decimal.TryParse(
            value.Replace(',', '.'),
            System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture,
            out var liters)
            ? Math.Round(liters, 1, MidpointRounding.AwayFromZero)
            : null;
        return Task.CompletedTask;
    }

    private async Task ScheduleModelReloadAsync()
    {
        _modelLoadCts?.Cancel();
        _modelLoadCts = new CancellationTokenSource();
        var ct = _modelLoadCts.Token;

        try
        {
            await Task.Delay(350, ct);
            await ReloadModelOptionsAsync(ct);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Newer brand keystroke superseded this load.
        }
    }

    private async Task ReloadModelOptionsAsync(CancellationToken ct = default)
    {
        var brand = _model.Brand?.Trim();
        if (string.IsNullOrWhiteSpace(brand) || _model.Year is null)
        {
            _modelOptions = [];
            _loadingModels = false;
            return;
        }

        _loadingModels = true;
        try
        {
            List<string> fromDb = [];
            try
            {
                fromDb = await Inventory.GetDistinctModelsAsync(brand, ct);
            }
            catch
            {
                // Keep going with NHTSA / free text.
            }

            IReadOnlyList<string> fromApi = [];
            try
            {
                fromApi = await VinLookup.GetModelsForMakeAsync(brand, _model.Year, ct);
            }
            catch
            {
                fromApi = [];
            }

            IEnumerable<string> mergedSource = fromApi.Count > 0 ? fromApi : fromDb;

            var merged = mergedSource
                .Where(m => !string.IsNullOrWhiteSpace(m))
                .Select(m => m.Trim())
                .GroupBy(m => m, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First())
                .OrderBy(m => m, StringComparer.OrdinalIgnoreCase)
                .Select(m => new ComboOption(m, m))
                .ToList();

            if (!string.IsNullOrWhiteSpace(_model.Model)
                && !merged.Any(o => string.Equals(o.Value, _model.Model, StringComparison.OrdinalIgnoreCase)))
            {
                merged.Insert(0, new ComboOption(_model.Model!, _model.Model!));
            }

            _modelOptions = merged;
        }
        catch
        {
            _modelOptions = [];
        }
        finally
        {
            _loadingModels = false;
        }
    }

    private async Task DecodeVinAsync()
    {
        if (Busy.IsBusy) return;
        _error = null;
        _info = null;
        _vinHint = null;

        try
        {
            await Busy.RunAsync(async () =>
            {
                VinDecodeResult result;
                try
                {
                    result = await VinLookup.DecodeAsync(_model.SourceVin);
                }
                catch (Exception ex)
                {
                    _error = $"No se pudo decodificar el VIN: {ex.Message}";
                    _vinHint = "¿Está bien el VIN?";
                    return;
                }

                try
                {
                    await ApplyVinDecodeAsync(result);
                }
                catch (Exception ex)
                {
                    _error = $"Se obtuvo el VIN pero falló al aplicar los datos: {ex.Message}";
                    _vinHint = "¿Está bien el VIN?";
                }
            }, "Decodificando VIN…");
        }
        catch (Exception ex)
        {
            _error = $"No se pudo decodificar el VIN: {ex.Message}";
            _vinHint = "¿Está bien el VIN?";
        }
    }

    private async Task ApplyVinDecodeAsync(VinDecodeResult result)
    {
        if (!string.IsNullOrWhiteSpace(result.Vin))
            _model.SourceVin = result.Vin;

        if (!string.IsNullOrWhiteSpace(result.ErrorMessage))
        {
            _error = result.ErrorMessage;
            _vinHint = "¿Está bien el VIN?";
            return;
        }

        if (!result.HasAnyData)
        {
            _info = result.Warning
                    ?? "No se pudo decodificar este VIN. Completa año, marca y modelo manualmente.";
            _vinHint = "¿Está bien el VIN?";
            return;
        }

        if (result.Year is not null)
            _model.Year = result.Year;
        if (!string.IsNullOrWhiteSpace(result.Make))
            _model.Brand = result.Make;
        if (!string.IsNullOrWhiteSpace(result.Model))
            _model.Model = result.Model;

        if (_model.ItemType == InventoryItemType.Engine)
        {
            if (result.DisplacementLiters is not null)
                _model.DisplacementLiters = result.DisplacementLiters;
        }
        else
        {
            if (result.TransmissionType is not null)
                _model.TransmissionType = result.TransmissionType;
            if (result.DriveType is not null)
                _model.DriveType = result.DriveType;
        }

        try
        {
            if (string.IsNullOrWhiteSpace(_model.Description)
                && !string.IsNullOrWhiteSpace(result.SuggestedDescription))
            {
                _model.Description = result.SuggestedDescription;
            }
        }
        catch
        {
            // Description seed is optional.
        }

        await ReloadModelOptionsAsync();

        _vinHint = null;
        _info = result.FromNhtsa
            ? "Se sugirieron campos desde el VIN (NHTSA). Revísalos y completa el resto."
            : result.Warning
              ?? "Solo se pudo sugerir año/marca de forma local. Completa el resto manualmente.";
    }

    private async Task SaveAsync()
    {
        if (Busy.IsBusy || _saving) return;
        _error = null;
        _saving = true;
        try
        {
            await Busy.RunAsync(async () =>
            {
                if (_model.PalletId <= 0)
                    throw new InvalidOperationException("Seleccione una paleta.");

                var created = await Inventory.AddAsync(
                    _model.ItemType,
                    _model.PartNumber,
                    _model.Brand,
                    _model.Model,
                    _model.Year,
                    _model.Description,
                    _model.Notes,
                    _model.PalletId,
                    _model.SourceVin,
                    _model.DisplacementLiters,
                    _model.TransmissionType,
                    _model.DriveType);

                if (_imageFile is not null)
                {
                    try
                    {
                        await using var stream = _imageFile.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024);
                        var path = await Media.SaveAsync(stream, _imageFile.Name, "parts", created.Id, _model.Brand);
                        await Inventory.SetImagePathAsync(created.Id, path);
                    }
                    catch (Exception imgEx)
                    {
                        _info = $"Pieza guardada, pero la foto falló: {imgEx.Message}";
                    }
                }

                Nav.NavigateTo("inventory");
            }, "Guardando pieza…");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private enum EntryMode
    {
        Manual,
        VinDecode
    }

    private sealed class CreateModel
    {
        public InventoryItemType ItemType { get; set; } = InventoryItemType.Engine;
        public int PalletId { get; set; }
        public string? SourceVin { get; set; }
        public string? Brand { get; set; }
        public string? Model { get; set; }
        public int? Year { get; set; }
        public decimal? DisplacementLiters { get; set; }
        public TransmissionType? TransmissionType { get; set; }
        public VehicleDriveType? DriveType { get; set; }
        public string? PartNumber { get; set; }
        public string? Description { get; set; }
        public string? Notes { get; set; }
    }
}
