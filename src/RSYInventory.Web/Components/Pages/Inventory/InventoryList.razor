@page "/inventory"
@inject InventoryService Inventory
@inject UiBusyService Busy

<PageTitle>Inventario</PageTitle>

<PageHeader Title="Inventario disponible"
            Eyebrow="Piezas"
            Lead="Busca por marca, modelo, año o ubicación. Solo se cargan piezas al abrir esta pantalla (no al iniciar sesión).">
    <a class="btn btn-primary" href="inventory/new">Añadir pieza</a>
    <a class="btn btn-outline-secondary" href="zones">Ver zonas</a>
</PageHeader>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_items is null)
{
    <div class="page-panel"><p class="mb-0 text-muted">Cargando inventario…</p></div>
}
else if (_items.Count == 0)
{
    <div class="page-panel empty-state">
        <p class="empty-state__title">No hay piezas disponibles</p>
        <p class="mb-3">Añade un motor o una transmisión y asígnalo a una paleta.</p>
        <a class="btn btn-primary" href="inventory/new">Añadir primera pieza</a>
    </div>
}
else
{
    <div class="page-panel mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label" for="inv-search">Búsqueda rápida</label>
                <input id="inv-search"
                       class="form-control"
                       placeholder="Marca, modelo, año, VIN, paleta, zona…"
                       @bind="_search"
                       @bind:event="oninput" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Tipo</label>
                <select class="form-select" @bind="_typeFilter">
                    <option value="">Todos</option>
                    <option value="engine">Motor</option>
                    <option value="transmission">Transmisión</option>
                </select>
            </div>
            <div class="col-md-3">
                <p class="form-hint mb-0">@Filtered.Count() de @_items.Count piezas</p>
            </div>
        </div>
    </div>

    @if (!Filtered.Any())
    {
        <div class="page-panel empty-state">
            <p class="empty-state__title">Sin resultados</p>
            <p class="mb-0">Prueba otra marca, modelo o ubicación.</p>
        </div>
    }
    else
    {
        <div class="page-panel table-shell">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th></th>
                        <th>Tipo</th>
                        <th>Marca / Modelo</th>
                        <th>Detalle</th>
                        <th>Año</th>
                        <th>Ubicación</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Filtered)
                    {
                        <tr>
                            <td style="width:3.25rem">
                                @if (!string.IsNullOrWhiteSpace(item.ImageRelativePath))
                                {
                                    <img class="thumb-img" src="@item.ImageRelativePath" alt="" />
                                }
                            </td>
                            <td>
                                @if (item.ItemType == (int)InventoryItemType.Engine)
                                {
                                    <span class="badge-type badge-type--engine">Motor</span>
                                }
                                else
                                {
                                    <span class="badge-type badge-type--transmission">Transmisión</span>
                                }
                            </td>
                            <td>
                                <strong>@(string.IsNullOrWhiteSpace($"{item.Brand} {item.Model}".Trim()) ? "Sin marca/modelo" : $"{item.Brand} {item.Model}".Trim())</strong>
                                @if (!string.IsNullOrWhiteSpace(item.PartNumber))
                                {
                                    <div class="form-hint">Nº @item.PartNumber</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.SourceVin))
                                {
                                    <div class="form-hint mono">VIN @item.SourceVin</div>
                                }
                            </td>
                            <td>@FormatDetails(item)</td>
                            <td>@(item.Year?.ToString() ?? "—")</td>
                            <td>@FormatLocation(item)</td>
                            <td class="text-end">
                                <div class="d-inline-flex flex-wrap gap-2 justify-content-end">
                                    <a class="btn btn-sm btn-outline-primary" href="@($"inventory/{item.Id}/move")">Mover / Vender</a>
                                    @if (item.PalletId is not null)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" href="@($"pallets/{item.PalletId}/movements")">Historial</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<InventoryItem>? _items;
    private string? _error;
    private string _search = string.Empty;
    private string _typeFilter = string.Empty;

    private IEnumerable<InventoryItem> Filtered
    {
        get
        {
            if (_items is null) return [];
            IEnumerable<InventoryItem> q = _items;

            if (_typeFilter == "engine")
                q = q.Where(i => i.ItemType == (int)InventoryItemType.Engine);
            else if (_typeFilter == "transmission")
                q = q.Where(i => i.ItemType == (int)InventoryItemType.Transmission);

            var s = _search.Trim();
            if (string.IsNullOrEmpty(s)) return q;

            return q.Where(i =>
                Contains(i.Brand, s)
                || Contains(i.Model, s)
                || Contains(i.PartNumber, s)
                || Contains(i.SourceVin, s)
                || Contains(i.Description, s)
                || Contains(i.Year?.ToString(), s)
                || Contains(FormatLocation(i), s)
                || Contains(FormatDetails(i), s));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Busy.RunAsync(async () =>
            {
                _items = await Inventory.GetAvailableAsync();
            }, "Cargando inventario…");
        }
        catch (Exception ex)
        {
            _error = ex.Message + " — ¿Ejecutaste los scripts SQL y configuraste la connection string?";
        }
    }

    private static bool Contains(string? haystack, string needle)
        => !string.IsNullOrEmpty(haystack)
           && haystack.Contains(needle, StringComparison.OrdinalIgnoreCase);

    private static string FormatLocation(InventoryItem item)
    {
        if (item.Pallet is null) return "Sin ubicación";
        return YardLayoutService.FormatPalletLabel(item.Pallet);
    }

    private static string FormatDetails(InventoryItem item)
    {
        if (item.ItemType == (int)InventoryItemType.Engine)
            return item.DisplacementLiters is null ? "—" : $"{item.DisplacementLiters:0.##} L";

        var tx = item.TransmissionType is null ? null : ((TransmissionType)item.TransmissionType.Value) switch
        {
            TransmissionType.Automatic => "Automática",
            TransmissionType.Manual => "Manual",
            _ => null
        };
        var drive = item.DriveType is null ? null : ((VehicleDriveType)item.DriveType.Value) switch
        {
            VehicleDriveType.Fwd => "FWD",
            VehicleDriveType.Rwd => "RWD",
            VehicleDriveType.Awd => "AWD",
            VehicleDriveType.FourByFour => "4x4",
            VehicleDriveType.FourByTwo => "4x2",
            _ => null
        };

        return string.Join(" · ", new[] { tx, drive }.Where(s => !string.IsNullOrEmpty(s)).DefaultIfEmpty("—"));
    }
}
