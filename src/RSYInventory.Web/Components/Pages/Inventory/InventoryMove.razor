@page "/inventory/{Id:int}/move"
@inject InventoryService Inventory
@inject YardLayoutService Layout
@inject UiBusyService Busy
@inject NavigationManager Nav

<PageTitle>Mover / Vender</PageTitle>

<PageHeader Title="Mover o vender pieza"
            Eyebrow="Inventario"
            Lead="Indica si la pieza se reubica a otra paleta o se marca como vendida.">
    <a class="btn btn-outline-secondary" href="inventory">Volver</a>
</PageHeader>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">@_error</div>
}

@if (_item is null && string.IsNullOrEmpty(_error))
{
    <div class="page-panel"><p class="mb-0 text-muted">Cargando pieza…</p></div>
}
else if (_item is not null)
{
    <div class="page-panel">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            @if (_item.ItemType == (int)InventoryItemType.Engine)
            {
                <span class="badge-type badge-type--engine">Motor</span>
            }
            else
            {
                <span class="badge-type badge-type--transmission">Transmisión</span>
            }
            <strong>@_item.Brand @_item.Model</strong>
        </div>
        <p class="meta-row mb-0">
            <span>Ubicación actual: <strong>@(_item.Pallet is null ? "—" : YardLayoutService.FormatPalletLabel(_item.Pallet))</strong></span>
        </p>
    </div>

    <div class="page-panel">
        <h2 class="page-panel__title">¿Qué ocurrió con la pieza?</h2>

        <div class="choice-cards mb-3">
            <button type="button"
                    class="choice-card text-start @(_movementType == MovementType.Relocated ? "is-selected" : null)"
                    @onclick="@(() => _movementType = MovementType.Relocated)">
                <strong>Solo reubicar</strong>
                <span>Se mueve a otra paleta y sigue disponible.</span>
            </button>
            <button type="button"
                    class="choice-card text-start @(_movementType == MovementType.Sold ? "is-selected" : null)"
                    @onclick="@(() => _movementType = MovementType.Sold)">
                <strong>Vendida</strong>
                <span>Sale del inventario y deja libre la paleta.</span>
            </button>
        </div>

        @if (_movementType == MovementType.Relocated)
        {
            <div class="mb-3">
                <label class="form-label" for="pallet-combo">Nueva paleta *</label>
                <SearchableCombo InputId="pallet-combo"
                                 Value="@PalletValue"
                                 ValueChanged="OnPalletChangedAsync"
                                 Options="_palletOptions"
                                 Placeholder="Escribe para filtrar zona, fila o paleta…"
                                 AllowCustom="false" />
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                Al confirmar, la pieza quedará marcada como vendida y sin ubicación.
            </div>
        }

        <div class="mb-3">
            <label class="form-label">Notas</label>
            <input class="form-control" @bind="_notes" placeholder="Opcional" />
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" disabled="@_saving" @onclick="ConfirmAsync">
                @(_saving ? "Guardando…" : "Confirmar")
            </button>
            <a class="btn btn-link" href="inventory">Cancelar</a>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private InventoryItem? _item;
    private List<Pallet> _pallets = [];
    private List<ComboOption> _palletOptions = [];
    private MovementType _movementType = MovementType.Relocated;
    private int _newPalletId;
    private string? _notes;
    private string? _error;
    private bool _saving;

    private string? PalletValue => _newPalletId <= 0 ? null : _newPalletId.ToString();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Busy.RunAsync(async () =>
            {
                _item = await Inventory.GetByIdAsync(Id);
                if (_item is null)
                {
                    _error = "Pieza no encontrada.";
                    return;
                }

                _pallets = await Layout.GetPalletsAsync(ZonePurpose.Parts);
                _palletOptions = _pallets
                    .Select(p =>
                    {
                        var label = YardLayoutService.FormatPalletLabel(p);
                        return new ComboOption(p.Id.ToString(), label, label);
                    })
                    .ToList();
            }, "Cargando pieza…");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private Task OnPalletChangedAsync(string? value)
    {
        _newPalletId = int.TryParse(value, out var id) ? id : 0;
        return Task.CompletedTask;
    }

    private async Task ConfirmAsync()
    {
        if (Busy.IsBusy || _saving) return;
        _error = null;
        _saving = true;
        try
        {
            await Busy.RunAsync(async () =>
            {
                await Inventory.ChangeLocationAsync(
                    Id,
                    _movementType,
                    _movementType == MovementType.Relocated ? _newPalletId : null,
                    _notes);

                Nav.NavigateTo("inventory");
            }, "Confirmando…");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
