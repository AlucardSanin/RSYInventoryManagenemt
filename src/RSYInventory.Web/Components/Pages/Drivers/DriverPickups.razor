        public string Title { get; init; } = "";
        public string Loading { get; init; } = "";
        public string InvalidLink { get; init; } = "";
        public string Hello { get; init; } = "";
        public string Lead { get; init; } = "";
        public string TabToday { get; init; } = "";
        public string TabHistory { get; init; } = "";
        public string EmptyToday { get; init; } = "";
        public string EmptyHistory { get; init; } = "";
        public string Price { get; init; } = "";
        public string Address { get; init; } = "";
        public string Scheduled { get; init; } = "";
        public string AppointmentTime { get; init; } = "";
        public string Source { get; init; } = "";
        public string Mileage { get; init; } = "";
        public string Payment { get; init; } = "";
        public string Seller { get; init; } = "";
        public string Phone { get; init; } = "";
        public string Notes { get; init; } = "";
        public string PickedAt { get; init; } = "";
        public string MarkPicked { get; init; } = "";
        public string MarkNotPicked { get; init; } = "";
        public string Close { get; init; } = "";
        public string ConfirmTitle { get; init; } = "";
        public string ConfirmPick { get; init; } = "";
        public string ConfirmRevert { get; init; } = "";
        public string Cancel { get; init; } = "";
        public string Yes { get; init; } = "";
        public string Saved { get; init; } = "";
        public string FilterToday { get; init; } = "";
        public string FilterYesterday { get; init; } = "";
        public string FilterWeek { get; init; } = "";
        public string From { get; init; } = "";
        public string To { get; init; } = "";
        public string ApplyFilter { get; init; } = "";
        public string Pending { get; init; } = "";
        public string PickedUp { get; init; } = "";
        public string Acquired { get; init; } = "";

        public static DriverUiText For(string? lang) =>
            string.Equals(lang, "en", StringComparison.OrdinalIgnoreCase) ? English : Spanish;

        public static DriverUiText Spanish { get; } = new()
        {
            Title = "Mis recogidas",
            Loading = "Cargando…",
            InvalidLink = "Enlace inválido o chofer inactivo.",
            Hello = "Hola",
            Lead = "Solo ves las recogidas de hoy. Toca un vehículo para el detalle y marcarlo como recogido.",
            TabToday = "Hoy",
            TabHistory = "Historial",
            EmptyToday = "No tienes vehículos pendientes para hoy.",
            EmptyHistory = "Sin recogidas en ese rango.",
            Price = "Precio",
            Address = "Dirección",
            Scheduled = "Para recoger",
            AppointmentTime = "Ventana con el vendedor",
            Source = "Fuente",
            Mileage = "Millas",
            Payment = "Pago",
            Seller = "Vendedor",
            Phone = "Teléfono",
            Notes = "Notas",
            PickedAt = "Recogido a las",
            MarkPicked = "Recogido",
            MarkNotPicked = "No recogido",
            Close = "Cerrar",
            ConfirmTitle = "Confirmar",
            ConfirmPick = "¿Seguro que quieres marcar como recogido? El vehículo pasará a la lista de adquiridos.",
            ConfirmRevert = "¿Seguro que quieres marcarlo como no recogido? Se quitará de adquiridos y volverá a pendientes.",
            Cancel = "Cancelar",
            Yes = "Sí",
            Saved = "Actualizado.",
            FilterToday = "Hoy",
            FilterYesterday = "Ayer",
            FilterWeek = "La semana pasada",
            From = "Desde",
            To = "Hasta",
            ApplyFilter = "Filtrar",
            Pending = "Pendiente",
            PickedUp = "Recogido",
            Acquired = "Adquirido"
        };

        public static DriverUiText English { get; } = new()
        {
            Title = "My pickups",
            Loading = "Loading…",
            InvalidLink = "Invalid link or inactive driver.",
            Hello = "Hi",
            Lead = "You only see today's pickups. Tap a vehicle for details and to mark it picked up.",
            TabToday = "Today",
            TabHistory = "History",
            EmptyToday = "No pending vehicles for today.",
            EmptyHistory = "No pickups in that range.",
            Price = "Price",
            Address = "Address",
            Scheduled = "Scheduled for",
            AppointmentTime = "Time window with seller",
            Source = "Source",
            Mileage = "Miles",
            Payment = "Payment",
            Seller = "Seller",
            Phone = "Phone",
            Notes = "Notes",
            PickedAt = "Picked up at",
            MarkPicked = "Picked up",
            MarkNotPicked = "Not picked up",
            Close = "Close",
