@page "/d/{Token:guid}"
@layout PublicLayout
@inject PickupScheduleService Schedules
@inject UiBusyService Busy
@inject ToastService Toasts

<PageTitle>@_t.Title</PageTitle>

@if (_loading)
{
    <div class="page-panel"><p class="mb-0 text-muted">@_t.Loading</p></div>
}
else if (_driver is null)
{
    <div class="alert alert-danger">@_t.InvalidLink</div>
}
else
{
    <div class="page-panel mb-3">
        <h1 class="h4 mb-1">@_t.Hello, @_driver.DisplayName</h1>
        <p class="form-hint mb-0">@_t.Lead</p>
    </div>

    <div class="page-panel mb-3">
        <div class="d-flex flex-wrap gap-2">
            <button type="button"
                    class="btn @(_tab == "today" ? "btn-primary" : "btn-outline-secondary")"
                    @onclick='() => _tab = "today"'>@_t.TabToday</button>
            <button type="button"
                    class="btn @(_tab == "history" ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="ShowHistoryAsync">@_t.TabHistory</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_tab == "today")
    {
        @if (_active.Count == 0)
        {
            <div class="page-panel empty-state">
                <p class="empty-state__title">@_t.EmptyToday</p>
            </div>
        }
        else
        {
            <div class="driver-card-list">
                @foreach (var s in _active)
                {
                    <button type="button" class="driver-card" @onclick="() => OpenDetail(s)">
                        <div class="driver-card__row">
                            <strong>@(s.Year?.ToString() ?? "—") @(s.Make) @(s.Model)</strong>
                            @StatusBadge(s)
                        </div>
                        <div class="driver-card__meta">
                            <span>@_t.Price: @UsdMoney.FormatOrDash(s.PurchasePrice)</span>
                            <span>@_t.Address: @(s.PickupAddress ?? "—")</span>
                        </div>
                        <div class="form-hint">
                            @_t.Scheduled: @s.ScheduledPickupDate.ToString("yyyy-MM-dd")
                            @if (!string.IsNullOrWhiteSpace(s.ScheduledPickupWindow))
                            {
                                <span> · @_t.AppointmentTime: @s.ScheduledPickupWindow</span>
                            }
                        </div>
                    </button>
                }
            </div>
        }
    }
    else
    {
        <div class="page-panel mb-3">
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="FilterHistoryTodayAsync">@_t.FilterToday</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="FilterHistoryYesterdayAsync">@_t.FilterYesterday</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="FilterHistoryWeekAsync">@_t.FilterWeek</button>
            </div>
            <div class="row g-2 align-items-end">
                <div class="col-6">
                    <label class="form-label">@_t.From</label>
                    <InputDate class="form-control" @bind-Value="_histFrom" />
                </div>
                <div class="col-6">
                    <label class="form-label">@_t.To</label>
                    <InputDate class="form-control" @bind-Value="_histTo" />
                </div>
                <div class="col-12">
                    <button type="button" class="btn btn-outline-primary w-100" @onclick="FilterHistoryCustomAsync">@_t.ApplyFilter</button>
                </div>
            </div>
        </div>

        @if (_history.Count == 0)
        {
            <div class="page-panel empty-state"><p class="empty-state__title">@_t.EmptyHistory</p></div>
        }
        else
        {
            <div class="driver-card-list">
                @foreach (var s in _history)
                {
                    <button type="button" class="driver-card" @onclick="() => OpenDetail(s)">
                        <div class="driver-card__row">
                            <strong>@(s.Year?.ToString() ?? "—") @(s.Make) @(s.Model)</strong>
                            @StatusBadge(s)
                        </div>
                        <div class="driver-card__meta">
                            <span>@_t.Price: @UsdMoney.FormatOrDash(s.PurchasePrice)</span>
                            <span>@_t.Address: @(s.PickupAddress ?? "—")</span>
                        </div>
                        <div class="form-hint">
                            @_t.PickedAt:
                            @(s.PickedUpAtUtc is null
                                ? "—"
                                : YardTimeZone.ToEastern(s.PickedUpAtUtc.Value).ToString("yyyy-MM-dd HH:mm"))
                        </div>
                    </button>
                }
            </div>
        }
    }
}

@if (_selected is not null)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">@(_selected.Year) @_selected.Make @_selected.Model</h2>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-0">
                        <dt class="col-5">VIN</dt><dd class="col-7"><code>@_selected.Vin</code></dd>
                        <dt class="col-5">@_t.Price</dt><dd class="col-7">@UsdMoney.FormatOrDash(_selected.PurchasePrice)</dd>
                        <dt class="col-5">@_t.Address</dt><dd class="col-7">@(_selected.PickupAddress ?? "—")</dd>
                        <dt class="col-5">@_t.Scheduled</dt><dd class="col-7">@_selected.ScheduledPickupDate.ToString("yyyy-MM-dd")</dd>
                        <dt class="col-5">@_t.AppointmentTime</dt>
                        <dd class="col-7">@(string.IsNullOrWhiteSpace(_selected.ScheduledPickupWindow) ? "—" : _selected.ScheduledPickupWindow)</dd>
                        <dt class="col-5">@_t.Source</dt><dd class="col-7">@_selected.VehicleSource.Name</dd>
                        <dt class="col-5">@_t.Mileage</dt><dd class="col-7">@(_selected.Mileage?.ToString("N0") ?? "—")</dd>
                        <dt class="col-5">@_t.Payment</dt><dd class="col-7">@(_selected.PaymentMethod ?? "—")</dd>
                        <dt class="col-5">@_t.Seller</dt><dd class="col-7">@(_selected.SellerName ?? "—")</dd>
                        <dt class="col-5">@_t.Phone</dt><dd class="col-7">@(_selected.SellerPhone ?? "—")</dd>
                        <dt class="col-5">@_t.Notes</dt><dd class="col-7">@(_selected.Observations ?? "—")</dd>
                        @if (_selected.PickedUpAtUtc is not null)
                        {
                            <dt class="col-5">@_t.PickedAt</dt>
                            <dd class="col-7">@YardTimeZone.ToEastern(_selected.PickedUpAtUtc.Value).ToString("yyyy-MM-dd HH:mm")</dd>
                        }
                    </dl>
                </div>
                <div class="modal-footer">
                    @{
                        var canEdit = _selected.Id > 0 && PickupScheduleService.CanDriverEditToday(_selected);
                        var isPicked = PickupScheduleService.IsPickedUpStatus(_selected.Status);
                    }
                    @if (_selected.Status == (byte)ScheduledPickupStatus.Pending)
                    {
                        <button type="button" class="btn btn-success" disabled="@(!canEdit || _busy)"
                                @onclick="ConfirmPickUpAsync">@_t.MarkPicked</button>
                    }
                    else if (isPicked)
                    {
                        <button type="button" class="btn btn-outline-danger" disabled="@(!canEdit || _busy)"
                                @onclick="ConfirmRevertAsync">@_t.MarkNotPicked</button>
                    }
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDetail">@_t.Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_confirmPick || _confirmRevert)
{
    <div class="modal-backdrop show" style="z-index:1060"></div>
    <div class="modal d-block" tabindex="-1" style="z-index:1070">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">@_t.ConfirmTitle</h2>
                </div>
                <div class="modal-body">
                    <p class="mb-0">@(_confirmPick ? _t.ConfirmPick : _t.ConfirmRevert)</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelConfirm">@_t.Cancel</button>
                    <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="ExecuteConfirmAsync">@_t.Yes</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Token { get; set; }

    private bool _loading = true;
    private bool _busy;
    private string _tab = "today";
    private string? _error;
    private User? _driver;
    private List<ScheduledVehiclePickup> _active = [];
    private List<ScheduledVehiclePickup> _history = [];
    private ScheduledVehiclePickup? _selected;
    private bool _confirmPick;
    private bool _confirmRevert;
    private DateTime? _histFrom;
    private DateTime? _histTo;
    private DriverUiText _t = DriverUiText.Spanish;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Busy.RunAsync(async () =>
            {
                var portal = await Schedules.GetDriverPortalAsync(Token);
                if (portal is null)
                {
                    _driver = null;
                    return;
                }

                _driver = portal.Driver;
                _t = DriverUiText.For(_driver.PreferredLanguage);
                _active = portal.ActivePickups;
            }, "…");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ShowHistoryAsync()
    {
        _tab = "history";
        await FilterHistoryWeekAsync();
    }

    private Task FilterHistoryTodayAsync() => FilterHistoryAsync("today");
    private Task FilterHistoryYesterdayAsync() => FilterHistoryAsync("yesterday");
    private Task FilterHistoryWeekAsync() => FilterHistoryAsync("week");
    private Task FilterHistoryCustomAsync() => FilterHistoryAsync(null);

    private async Task FilterHistoryAsync(string? preset)
    {
        var today = YardTimeZone.TodayEastern();
        if (preset == "today")
        {
            _histFrom = today.ToDateTime(TimeOnly.MinValue);
            _histTo = today.ToDateTime(TimeOnly.MinValue);
        }
        else if (preset == "yesterday")
        {
            var y = today.AddDays(-1);
            _histFrom = y.ToDateTime(TimeOnly.MinValue);
            _histTo = y.ToDateTime(TimeOnly.MinValue);
        }
        else if (preset == "week")
        {
            _histFrom = today.AddDays(-7).ToDateTime(TimeOnly.MinValue);
            _histTo = today.ToDateTime(TimeOnly.MinValue);
        }

        _error = null;
        try
        {
            await Busy.RunAsync(async () =>
            {
                DateOnly? from = _histFrom is null ? null : DateOnly.FromDateTime(_histFrom.Value);
                DateOnly? to = _histTo is null ? null : DateOnly.FromDateTime(_histTo.Value);
                _history = await Schedules.GetDriverHistoryAsync(Token, from, to);
            }, "…");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void OpenDetail(ScheduledVehiclePickup s) => _selected = s;
    private void CloseDetail()
    {
        _selected = null;
        _confirmPick = false;
        _confirmRevert = false;
    }

    private void ConfirmPickUpAsync() => _confirmPick = true;
    private void ConfirmRevertAsync() => _confirmRevert = true;
    private void CancelConfirm()
    {
        _confirmPick = false;
        _confirmRevert = false;
    }

    private async Task ExecuteConfirmAsync()
    {
        if (_selected is null || _busy) return;
        _busy = true;
        _error = null;
        try
        {
            try
            {
                if (_confirmPick)
                    await Schedules.MarkPickedUpAsync(Token, _selected.Id);
                else if (_confirmRevert)
                    await Schedules.MarkNotPickedUpAsync(Token, _selected.Id);
            }
            catch (Exception ex)
            {
                _error = LocalizeDriverError(ex.Message);
                Toasts.Error(_error);
                return;
            }

            var portal = await Schedules.GetDriverPortalAsync(Token);
            _active = portal?.ActivePickups ?? [];
            if (_tab == "history")
                await FilterHistoryCustomAsync();

            _selected = _active.FirstOrDefault(x => x.Id == _selected.Id)
                        ?? _history.FirstOrDefault(x => x.Id == _selected.Id);
            _confirmPick = false;
            _confirmRevert = false;
            Toasts.Success(_t.Saved);
        }
        catch (Exception ex)
        {
            _error = LocalizeDriverError(ex.Message);
            Toasts.Error(_error);
        }
        finally
        {
            _busy = false;
        }
    }

    private string LocalizeDriverError(string message)
    {
        var en = string.Equals(_driver?.PreferredLanguage, "en", StringComparison.OrdinalIgnoreCase);
        if (message.Contains("collection day has ended", StringComparison.OrdinalIgnoreCase)
            || message.Contains("no longer be changed", StringComparison.OrdinalIgnoreCase))
            return en
                ? "This pickup can no longer be changed after the collection day has ended."
                : "Ya no se puede cambiar esta recolección después del día de recogida.";
        if (message.Contains("Already marked", StringComparison.OrdinalIgnoreCase))
            return en ? "Already marked as picked up." : "Ya está marcado como recogido.";
        if (message.Contains("ubicación", StringComparison.OrdinalIgnoreCase)
            || message.Contains("yard", StringComparison.OrdinalIgnoreCase))
            return en
                ? "Cannot revert: the vehicle already has a yard location."
                : "No se puede revertir: el vehículo ya tiene ubicación en la yarda.";
        if (message.Contains("recibo", StringComparison.OrdinalIgnoreCase)
            || message.Contains("invoice", StringComparison.OrdinalIgnoreCase)
            || message.Contains("firma", StringComparison.OrdinalIgnoreCase)
            || message.Contains("signature", StringComparison.OrdinalIgnoreCase))
            return en
                ? "Cannot revert: the vehicle already has a receipt or signature."
                : "No se puede revertir: el vehículo ya tiene recibo o firma.";
        return message;
    }

    private RenderFragment StatusBadge(ScheduledVehiclePickup s) => __builder =>
    {
        var pending = s.Status == (byte)ScheduledPickupStatus.Pending;
        __builder.OpenElement(0, "span");
        __builder.AddAttribute(1, "class", pending ? "badge-status badge-status--danger" : "badge-status badge-status--ok");
        __builder.AddContent(2, pending ? _t.Pending : _t.PickedUp);
        __builder.CloseElement();
    };

    private sealed class DriverUiText
