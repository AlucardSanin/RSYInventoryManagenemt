@inject UiBusyService Busy
@implements IDisposable

@if (Busy.IsBusy)
{
    <div class="busy-overlay" aria-live="polite" aria-busy="true">
        <div class="busy-overlay__card">
            <div class="busy-overlay__spinner" role="status"></div>
            <p class="busy-overlay__text">@Busy.Message</p>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => Busy.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Busy.Changed -= OnChanged;
}
